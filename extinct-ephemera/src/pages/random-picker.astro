---
import Layout from '../layouts/Layout.astro';
import ToolLayout from '../components/ToolLayout.astro';
import ShareButton from '../components/ShareButton.astro';

const title = 'Random Wheel - Spin & Choose | Randomlyo';
const description = 'Enter your options and spin the wheel to make a random choice.';
---

<Layout title={title} description={description}>
  <ToolLayout title="Random Wheel" description="Enter your options and spin the wheel to make a random choice." toolId="randomPicker">
    <div class="grid min-w-0 items-start gap-5 xl:grid-cols-[minmax(19rem,0.75fr)_minmax(32rem,1.25fr)]">
      <section class="surface min-w-0 p-5 sm:p-6" aria-labelledby="options-heading">
        <div class="flex items-start justify-between gap-4 border-b border-line pb-5">
          <div>
            <p class="eyebrow">Your options</p>
            <h2 id="options-heading" class="mt-2 text-xl">What are we choosing?</h2>
          </div>
          <span id="optionCount" class="rounded-full bg-wash px-3 py-1 text-xs font-bold text-ink-soft">0 options</span>
        </div>

        <div id="optionsEditor" class="mt-5 space-y-2" aria-live="polite"></div>

        <form id="addOptionForm" class="mt-4 flex gap-2">
          <label for="newOption" class="sr-only">Add an option</label>
          <input id="newOption" type="text" class="min-h-11 min-w-0 flex-1 rounded-xl border border-line bg-white px-4 text-sm text-ink placeholder:text-ink-soft/60" placeholder="Add an option" autocomplete="off" />
          <button type="submit" class="secondary-action min-h-11 shrink-0 px-4" aria-label="Add option">+ Add</button>
        </form>

        <details class="mt-5 border-t border-line pt-4">
          <summary class="cursor-pointer text-sm font-bold text-ink-soft transition-colors hover:text-ink">Paste a list - one option per line</summary>
          <div class="mt-3">
            <label for="pasteOptions" class="sr-only">Paste a list of options</label>
            <textarea id="pasteOptions" rows="5" class="w-full resize-y rounded-xl border border-line bg-wash px-4 py-3 text-sm text-ink placeholder:text-ink-soft/60" placeholder="Pizza
Burger
Pasta"></textarea>
            <button id="importOptions" type="button" class="secondary-action mt-3 min-h-10 px-4 text-xs">Add pasted options</button>
          </div>
        </details>

        <div class="mt-5 flex items-center justify-between border-t border-line pt-4">
          <button id="clearOptions" type="button" class="text-sm font-bold text-ink-soft underline decoration-line underline-offset-4 hover:text-ink">Clear all</button>
          <p class="text-xs text-ink-soft">Keep it simple. Two options is enough.</p>
        </div>
      </section>

      <section class="surface min-h-[34rem] min-w-0 bg-white p-5 sm:p-8" aria-labelledby="wheel-heading">
        <div class="flex items-start justify-between gap-4">
          <div><p class="eyebrow">The moment of truth</p><h2 id="wheel-heading" class="mt-2 text-xl">Spin the wheel</h2></div>
          <div class="flex shrink-0 items-center gap-3">
            <span id="wheelStatus" class="text-xs font-bold text-ink-soft">Add options to begin</span>
            <button
              id="soundToggle"
              type="button"
              class="grid h-9 w-9 place-items-center rounded-lg border border-line text-base leading-none text-ink-soft transition-[background-color,color,transform] duration-200 hover:bg-wash hover:text-ink active:scale-[0.94]"
              aria-pressed="false"
              aria-label="Turn sound on"
              title="Sound is off"
            ><span id="soundIcon" aria-hidden="true">🔇</span></button>
          </div>
        </div>

        <div class="relative mx-auto mt-7 aspect-square w-full max-w-[34rem]">
          <div class="absolute left-1/2 top-0 z-10 -translate-x-1/2 -translate-y-1/3 text-3xl text-ink" aria-hidden="true">▼</div>
          <canvas id="wheelCanvas" class="h-full w-full"></canvas>
          <div id="emptyWheel" class="pointer-events-none absolute inset-0 grid place-items-center text-center">
            <div><p class="text-5xl">🎡</p><p class="mt-3 text-sm font-bold text-ink-soft">Your wheel will appear here</p></div>
          </div>
        </div>

        <div id="resultContainer" class="mt-5 hidden border-t border-line pt-5 text-center">
          <p class="eyebrow">We have a winner</p>
          <p id="pickedResult" class="mt-2 text-4xl sm:text-5xl">-</p>
          <div class="mt-5 flex flex-wrap justify-center gap-2">
            <button id="spinAgainBtn" type="button" class="primary-action">Spin Again</button>
            <button id="copyBtn" type="button" class="secondary-action">Copy Result</button>
            <ShareButton resultId="" tool="random-picker" label="Share" />
          </div>
        </div>

        <div class="mt-7 flex justify-center">
          <button id="spinBtn" type="button" class="primary-action min-w-52" disabled>Spin the Wheel</button>
        </div>
      </section>
    </div>

  </ToolLayout>
</Layout>

<script>
  import { getRandomInt } from '../lib/random';
  import { parseList } from '../lib/utils';
  import { burstConfetti, createSoundKit, revealResult } from '../lib/effects';

  const optionsEditor = document.getElementById('optionsEditor') as HTMLElement;
  const optionCount = document.getElementById('optionCount') as HTMLElement;
  const newOption = document.getElementById('newOption') as HTMLInputElement;
  const addOptionForm = document.getElementById('addOptionForm') as HTMLFormElement;
  const pasteOptions = document.getElementById('pasteOptions') as HTMLTextAreaElement;
  const importOptions = document.getElementById('importOptions') as HTMLButtonElement;
  const clearOptions = document.getElementById('clearOptions') as HTMLButtonElement;
  const wheelStatus = document.getElementById('wheelStatus') as HTMLElement;
  const wheelCanvas = document.getElementById('wheelCanvas') as HTMLCanvasElement;
  const emptyWheel = document.getElementById('emptyWheel') as HTMLElement;
  const spinBtn = document.getElementById('spinBtn') as HTMLButtonElement;
  const resultContainer = document.getElementById('resultContainer') as HTMLElement;
  const pickedResult = document.getElementById('pickedResult') as HTMLElement;
  const spinAgainBtn = document.getElementById('spinAgainBtn') as HTMLButtonElement;
  const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement;
  const shareButton = document.querySelector<HTMLElement>('[data-share-button][data-tool="random-picker"]');

  let options = ['Pizza', 'Burger', 'Pasta', 'Sandwich', 'Sushi'];
  let rotation = 0;
  let spinning = false;
  let animationId = 0;
  const colors = ['#17233f', '#aebeff', '#7e93eb', '#dfe5f0', '#56627a', '#f3f6fc'];

  const easeOutQuart = (t: number) => 1 - Math.pow(1 - t, 4);
  const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

  /* ---------- Sound (off by default, opt-in via the speaker toggle) ---------- */

  const SOUND_PREF_KEY = 'randomlyo:wheel-sound';
  const sound = createSoundKit();
  const soundToggle = document.getElementById('soundToggle') as HTMLButtonElement;
  const soundIcon = document.getElementById('soundIcon') as HTMLElement;

  function applySoundPreference(muted: boolean) {
    sound.setMuted(muted);
    soundIcon.textContent = muted ? '🔇' : '🔊';
    soundToggle.setAttribute('aria-pressed', String(!muted));
    soundToggle.setAttribute('aria-label', muted ? 'Turn sound on' : 'Turn sound off');
    soundToggle.title = muted ? 'Sound is off' : 'Sound is on';
  }

  let soundMuted = true;
  try {
    soundMuted = localStorage.getItem(SOUND_PREF_KEY) !== 'on';
  } catch {
    soundMuted = true;
  }
  applySoundPreference(soundMuted);

  soundToggle.addEventListener('click', () => {
    soundMuted = !soundMuted;
    applySoundPreference(soundMuted);
    if (!soundMuted) {
      // A user gesture is the only reliable moment to start audio on iOS Safari.
      sound.unlock();
      sound.chime();
    }
    try {
      localStorage.setItem(SOUND_PREF_KEY, soundMuted ? 'off' : 'on');
    } catch {
      /* storage unavailable — preference stays session-only */
    }
  });

  function renderOptions() {
    optionsEditor.replaceChildren();
    options.forEach((option, index) => {
      const row = document.createElement('div');
      row.className = 'group flex items-center gap-2 rounded-xl border border-line bg-wash px-3 py-2';
      const number = document.createElement('span');
      number.className = 'w-5 text-xs font-bold text-ink-soft';
      number.textContent = `${index + 1}`;
      const input = document.createElement('input');
      input.className = 'min-w-0 flex-1 bg-transparent px-1 py-1 text-sm font-semibold text-ink outline-none';
      input.value = option;
      input.setAttribute('aria-label', `Option ${index + 1}`);
      input.addEventListener('change', () => { const value = input.value.trim(); if (value) options[index] = value; else options.splice(index, 1); renderOptions(); resizeCanvas(); });
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'grid h-8 w-8 place-items-center rounded-lg text-lg text-ink-soft opacity-60 transition hover:bg-white hover:text-ink group-hover:opacity-100';
      remove.textContent = '×';
      remove.setAttribute('aria-label', `Remove ${option}`);
      remove.addEventListener('click', () => { options.splice(index, 1); renderOptions(); resizeCanvas(); });
      row.append(number, input, remove);
      optionsEditor.append(row);
    });
    optionCount.textContent = `${options.length} option${options.length === 1 ? '' : 's'}`;
    wheelStatus.textContent = options.length >= 2 ? 'Ready to spin' : 'Add at least 2 options';
    spinBtn.disabled = options.length < 2 || spinning;
    emptyWheel.classList.toggle('hidden', options.length >= 2);
  }

  function resizeCanvas() {
    const size = wheelCanvas.parentElement?.clientWidth || 480;
    const pixelRatio = window.devicePixelRatio || 1;
    wheelCanvas.width = size * pixelRatio;
    wheelCanvas.height = size * pixelRatio;
    wheelCanvas.style.width = `${size}px`;
    wheelCanvas.style.height = `${size}px`;
    wheelCanvas.style.maxWidth = '100%';
    const context = wheelCanvas.getContext('2d');
    if (context) context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
    drawWheel(size);
  }

  function drawWheel(size = wheelCanvas.clientWidth) {
    if (options.length < 2 || size <= 0) return;
    const context = wheelCanvas.getContext('2d');
    if (!context) return;
    const center = size / 2;
    const radius = center - 12;
    const slice = (Math.PI * 2) / options.length;
    context.clearRect(0, 0, size, size);
    options.forEach((option, index) => {
      const start = rotation + index * slice;
      context.beginPath();
      context.moveTo(center, center);
      context.arc(center, center, radius, start, start + slice);
      context.closePath();
      context.fillStyle = colors[index % colors.length];
      context.fill();
      context.strokeStyle = '#ffffff';
      context.lineWidth = 3;
      context.stroke();
      context.save();
      context.translate(center + Math.cos(start + slice / 2) * radius * 0.62, center + Math.sin(start + slice / 2) * radius * 0.62);
      context.rotate(start + slice / 2 + Math.PI / 2);
      context.fillStyle = index % colors.length === 0 || index % colors.length === 4 ? '#ffffff' : '#17233f';
      context.font = 'bold 14px Trebuchet MS';
      context.textAlign = 'center';
      context.textBaseline = 'middle';
      context.fillText(option.length > 14 ? `${option.slice(0, 12)}...` : option, 0, 0);
      context.restore();
    });
    context.beginPath();
    context.arc(center, center, 18, 0, Math.PI * 2);
    context.fillStyle = '#ffffff';
    context.fill();
    context.strokeStyle = '#17233f';
    context.lineWidth = 3;
    context.stroke();
  }

  function spin() {
    if (spinning || options.length < 2) return;
    spinning = true;
    spinBtn.disabled = true;
    resultContainer.classList.add('hidden');
    resultContainer.classList.remove('result-reveal');

    // A click is a user gesture, so this is the reliable moment to satisfy
    // autoplay policies when sound was enabled on a previous visit. Skipped
    // while muted so no audio machinery is ever created for silent visitors.
    if (!soundMuted) sound.unlock();

    const winnerIndex = getRandomInt(0, options.length);
    const slice = (Math.PI * 2) / options.length;

    // Angle where the winning segment's CENTER must land: pointer is at top = -π/2
    const winnerCenterAngle = (winnerIndex + 0.5) * slice;
    const finalRestingAngle = -Math.PI / 2 - winnerCenterAngle;

    const startRotation = rotation;
    const fullSpins = Math.PI * 2 * 5;

    // Find the smallest rotation >= startRotation + fullSpins that lands exactly
    // on finalRestingAngle (mod 2π), so we always spin FORWARD, never backward.
    const twoPi = Math.PI * 2;
    const base = startRotation + fullSpins;
    const remainder = ((finalRestingAngle - base) % twoPi + twoPi) % twoPi;
    const targetRotation = base + remainder;

    // A real wheel doesn't stop dead — it drifts past the mark and settles back.
    // Scale the drift to the segment size so dense wheels stay subtle, and keep
    // it well under half a segment so it never reads as the wrong answer.
    const overshoot = slice * 0.12;
    const settleAt = 0.94; // last ~150ms of the spin is the settle-back

    const startTime = performance.now();
    const duration = 2600;

    let lastTickBoundary = Math.floor(startRotation / slice);
    let lastTickAt = 0;

    const animate = (time: number) => {
      const progress = Math.min((time - startTime) / duration, 1);

      if (progress <= settleAt) {
        const eased = easeOutQuart(progress / settleAt);
        rotation = startRotation + (targetRotation + overshoot - startRotation) * eased;
      } else {
        const t = (progress - settleAt) / (1 - settleAt);
        rotation = targetRotation + overshoot * (1 - easeOutCubic(t));
      }

      // Tick each time a segment boundary sweeps past the pointer. Throttled so
      // a wheel with many segments ticks like a wheel, not a buzzsaw.
      const boundary = Math.floor(rotation / slice);
      if (boundary > lastTickBoundary) {
        if (time - lastTickAt > 55) {
          sound.tick();
          lastTickAt = time;
        }
        lastTickBoundary = boundary;
      }

      drawWheel();
      if (progress < 1) {
        animationId = requestAnimationFrame(animate);
      } else {
        spinning = false;
        rotation = targetRotation % twoPi;
        pickedResult.textContent = options[winnerIndex];
        revealResult(resultContainer);
        wheelStatus.textContent = 'Choice made';
        spinBtn.disabled = false;
        if (shareButton) shareButton.dataset.resultId = options[winnerIndex];
        sound.chime();
        burstConfetti(pickedResult);
      }
    };
    animationId = requestAnimationFrame(animate);
  }

  function addOptions(values: string[], refocus = true) {
    const incoming = values.filter((value) => value.length > 0);
    if (!incoming.length) {
      if (refocus) newOption.focus();
      return;
    }
    options.push(...incoming);
    renderOptions();
    resizeCanvas();
    if (refocus) newOption.focus();
  }

  addOptionForm.addEventListener('submit', (event) => {
    event.preventDefault();
    const value = newOption.value;
    newOption.value = '';
    addOptions(parseList(value));
  });

  // Pasting a comma- or newline-separated list straight into the single field
  // should just work — no need to hunt for the "paste a list" panel first.
  newOption.addEventListener('paste', (event) => {
    const pasted = event.clipboardData?.getData('text') ?? '';
    if (!/[\n,]/.test(pasted)) return;
    event.preventDefault();
    const typed = newOption.value.trim();
    newOption.value = '';
    addOptions(parseList(typed ? `${typed}, ${pasted}` : pasted));
  });

  importOptions.addEventListener('click', () => {
    const pasted = parseList(pasteOptions.value);
    if (pasted.length) {
      pasteOptions.value = '';
      addOptions(pasted, false);
    }
  });
  clearOptions.addEventListener('click', () => { options = []; resultContainer.classList.add('hidden'); renderOptions(); resizeCanvas(); });
  spinBtn.addEventListener('click', spin);
  spinAgainBtn.addEventListener('click', spin);
  copyBtn.addEventListener('click', async () => { await navigator.clipboard.writeText(pickedResult.textContent || ''); copyBtn.textContent = 'Copied'; window.setTimeout(() => { copyBtn.textContent = 'Copy Result'; }, 1600); });
  window.addEventListener('resize', resizeCanvas);
  renderOptions();
  requestAnimationFrame(resizeCanvas);
</script>
