---
import Layout from '../layouts/Layout.astro';
import ToolLayout from '../components/ToolLayout.astro';
import ListInput from '../components/ListInput.astro';

const defaultGames = 'Charades, Mario Kart, Codenames, Chess, Pictionary, 20 Questions, Uno, Trivial Pursuit';
---

<Layout title="Random Game Picker | Randomlyo" description="Can't decide what to play? Pick a random game and get started.">
  <ToolLayout title="Random Game Picker" description="Can't decide what to play? Pick one at random." toolId="randomGamePicker">
    <div class="grid items-start gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <section class="surface p-5 sm:p-7" aria-labelledby="game-options">
        <p class="eyebrow">Game options</p>
        <h2 id="game-options" class="mt-2 text-xl">What could you play?</h2>
        <ListInput id="gameList" defaultValue={defaultGames} placeholder="Charades, Mario Kart, Codenames" class="mt-5" />
        <p class="mt-3 text-xs text-ink-soft">Separate games with commas or new lines.</p>
        <button id="chooseGame" type="button" class="primary-action mt-6 w-full">Pick a game</button>
        <p id="gameError" class="mt-4 hidden border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert"></p>
      </section>
      <section class="surface flex min-h-[25rem] flex-col justify-center bg-white p-5 text-center sm:p-8" aria-live="polite">
        <p class="eyebrow">Game night</p>
        <p id="gameResult" class="mt-6 min-h-16 text-5xl sm:text-6xl">?</p>
        <p id="gameHint" class="mt-4 text-sm text-ink-soft">No scrolling through lists. Just play.</p>
      </section>
    </div>
  </ToolLayout>
</Layout>

<script>
  import { pickRandom } from '../lib/random';
  import { validateList } from '../lib/utils';
  import { revealResult } from '../lib/effects';
  const gameList = document.getElementById('gameList') as HTMLTextAreaElement;
  const result = document.getElementById('gameResult') as HTMLElement;
  const hint = document.getElementById('gameHint') as HTMLElement;
  const error = document.getElementById('gameError') as HTMLElement;
  const button = document.getElementById('chooseGame') as HTMLButtonElement;
  let revealing = false;

  function shuffleReveal(items: string[], finalPick: string): Promise<void> {
    return new Promise((resolve) => {
      if (items.length <= 1) {
        result.textContent = finalPick;
        revealResult(result);
        resolve();
        return;
      }
      const duration = 1100;
      const startedAt = performance.now();
      result.classList.add('is-shuffling');
      const timer = window.setInterval(() => {
        if (performance.now() - startedAt >= duration) {
          window.clearInterval(timer);
          result.textContent = finalPick;
          result.classList.remove('is-shuffling');
          revealResult(result);
          resolve();
          return;
        }
        result.textContent = pickRandom(items);
      }, 80);
    });
  }

  button?.addEventListener('click', async () => {
    if (revealing) return;
    const validation = validateList(gameList.value);
    if (!validation.valid) {
      error.textContent = validation.error || 'Add at least one game';
      error.classList.remove('hidden');
      return;
    }
    error.classList.add('hidden');
    revealing = true;
    button.disabled = true;
    hint.textContent = 'Shuffling the pile...';
    const winner = pickRandom(validation.items);
    await shuffleReveal(validation.items, winner);
    hint.textContent = 'That is your next game.';
    revealing = false;
    button.disabled = false;
  });
</script>

<style>
  #gameResult.is-shuffling {
    animation: gameShuffle 0.36s ease-in-out infinite;
  }

  @keyframes gameShuffle {
    0%, 100% {
      transform: translateY(0) scale(1);
      opacity: 0.55;
    }
    50% {
      transform: translateY(-6px) scale(1.05);
      opacity: 1;
    }
  }
</style>
