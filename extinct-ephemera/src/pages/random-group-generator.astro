---
import Layout from '../layouts/Layout.astro';
import ToolLayout from '../components/ToolLayout.astro';
import ListInput from '../components/ListInput.astro';

const title = 'Random Group Generator - Create Groups | Randomlyo';
const description = 'Divide people into random groups instantly. Perfect for activities and events.';
const defaultParticipants = 'Person 1, Person 2, Person 3, Person 4, Person 5, Person 6';
---

<Layout title={title} description={description}>
  <ToolLayout
    title="Random Group Generator"
    description="Divide people into random groups."
    toolId="randomGroupGenerator"
  >
    <div class="grid items-start gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <section class="surface p-5 sm:p-7" aria-labelledby="group-setup">
        <p class="eyebrow">Group setup</p>
        <h2 id="group-setup" class="mt-2 text-xl">Who is being split?</h2>

        <ListInput
          id="participantsList"
          defaultValue={defaultParticipants}
          placeholder="Person 1, Person 2, Person 3"
          entryLabel="Add a participant, then press Enter"
          class="mt-5"
        />

        <fieldset class="mt-6 border-t border-line pt-5">
          <legend class="sr-only">Group mode</legend>

          <label class="flex items-center gap-3 text-sm font-bold text-ink-soft" for="numGroups">
            <input type="radio" name="groupMode" value="count" checked class="h-4 w-4 accent-brand-deep" />
            Create groups
          </label>
          <input
            id="numGroups"
            type="number"
            min="2"
            value="3"
            class="mt-2 min-h-11 w-full rounded-xl border border-line bg-white px-3 text-ink disabled:bg-wash disabled:text-ink-soft"
          />

          <label class="mt-5 flex items-center gap-3 text-sm font-bold text-ink-soft" for="peoplePerGroup">
            <input type="radio" name="groupMode" value="size" class="h-4 w-4 accent-brand-deep" />
            People per group
          </label>
          <input
            id="peoplePerGroup"
            type="number"
            min="1"
            value="2"
            disabled
            class="mt-2 min-h-11 w-full rounded-xl border border-line bg-white px-3 text-ink disabled:bg-wash disabled:text-ink-soft"
          />
        </fieldset>

        <button id="generateBtn" type="button" class="primary-action mt-7 w-full">Generate groups <span aria-hidden="true">-&gt;</span></button>
        <button id="resetBtn" type="button" class="mt-4 w-full text-sm font-bold text-ink-soft underline decoration-line underline-offset-4 hover:text-ink">Reset</button>
        <p id="errorContainer" class="mt-4 hidden border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert"><span id="errorMessage"></span></p>
      </section>

      <section class="surface min-h-[25rem] bg-white p-5 sm:p-7" aria-live="polite">
        <p class="eyebrow">The groups</p>
        <div id="emptyState" class="py-20 text-center">
          <p class="text-5xl" aria-hidden="true">👥</p>
          <p class="mt-4 text-sm text-ink-soft">Your groups will appear here.</p>
        </div>
        <div id="resultContainer" class="mt-5 hidden">
          <div id="groupsDisplay" class="grid gap-3 sm:grid-cols-2"></div>
        </div>
      </section>
    </div>

    <!-- Kept for search engines; the workspace itself is a two-panel layout. -->
    <div class="mx-auto mt-12 max-w-2xl">
      <!-- Common Uses -->
      <section class="legacy-section mb-12">
        <h2 class="text-2xl font-bold mb-6">Common Uses</h2>
        <ul class="space-y-3 text-ink-soft">
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Breakout rooms for online meetings</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Group project assignments</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Workshop activity groups</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Event table assignments</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Rotation groups for activities</span>
          </li>
        </ul>
      </section>

      <!-- FAQ -->
      <section class="legacy-section">
        <h2 class="text-2xl font-bold mb-6">Frequently Asked Questions</h2>
        <div class="space-y-6">
          <div>
            <h3 class="font-bold mb-2">Can groups be different sizes?</h3>
            <p class="text-ink-soft">Yes, if the number of people doesn't divide evenly, some groups will have one extra person. We distribute as fairly as possible.</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Can I change my mind and regenerate?</h3>
            <p class="text-ink-soft">Yes, click "Generate Groups" again to create a new random distribution.</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Is this truly random?</h3>
            <p class="text-ink-soft">Yes, people are randomly distributed with equal probability using cryptographic randomization.</p>
          </div>
        </div>
      </section>
    </div>
  </ToolLayout>
</Layout>

<script>
  import { validateList } from '../lib/utils';
  import { shuffleArray } from '../lib/random';
  import { revealResult } from '../lib/effects';

  const participantsList = document.getElementById('participantsList') as HTMLTextAreaElement;
  const numGroups = document.getElementById('numGroups') as HTMLInputElement;
  const peoplePerGroup = document.getElementById('peoplePerGroup') as HTMLInputElement;
  const generateBtn = document.getElementById('generateBtn') as HTMLButtonElement;
  const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;
  const resultContainer = document.getElementById('resultContainer') as HTMLElement;
  const emptyState = document.getElementById('emptyState') as HTMLElement;
  const groupsDisplay = document.getElementById('groupsDisplay') as HTMLElement;
  const errorContainer = document.getElementById('errorContainer') as HTMLElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLElement;
  const groupModeRadios = document.querySelectorAll('input[name="groupMode"]');

  groupModeRadios.forEach(radio => {
    radio.addEventListener('change', (e) => {
      const isCount = (e.target as HTMLInputElement).value === 'count';
      numGroups.disabled = !isCount;
      peoplePerGroup.disabled = isCount;
    });
  });

  generateBtn.addEventListener('click', () => {
    try {
      const validation = validateList(participantsList.value);
      if (!validation.valid) {
        errorMessage.textContent = validation.error || 'Invalid input';
        errorContainer.classList.remove('hidden');
        return;
      }

      const mode = (document.querySelector('input[name="groupMode"]:checked') as HTMLInputElement)?.value || 'count';
      let groups: string[][] = [];

      if (mode === 'count') {
        const count = parseInt(numGroups.value);
        if (isNaN(count) || count < 2) {
          throw new Error('Please enter at least 2 groups');
        }
        if (count > validation.items.length) {
          throw new Error(`Cannot create ${count} groups from ${validation.items.length} people`);
        }

        const shuffled = shuffleArray(validation.items);
        groups = Array.from({ length: count }, () => [] as string[]);
        shuffled.forEach((person, index) => {
          groups[index % count].push(person);
        });
      } else {
        const size = parseInt(peoplePerGroup.value);
        if (isNaN(size) || size < 1) {
          throw new Error('Please enter a valid group size');
        }

        const shuffled = shuffleArray(validation.items);
        groups = [];
        for (let i = 0; i < shuffled.length; i += size) {
          groups.push(shuffled.slice(i, i + size));
        }
      }

      groupsDisplay.innerHTML = groups.map((group, index) => `
        <article class="border border-line bg-wash p-5">
          <p class="eyebrow">Group ${index + 1}</p>
          <ul class="mt-4 space-y-2 text-sm font-semibold">
            ${group.map(person => `<li>${person}</li>`).join('')}
          </ul>
          <p class="mt-5 text-xs text-ink-soft">${group.length} person${group.length !== 1 ? 's' : ''}</p>
        </article>
      `).join('');

      emptyState.classList.add('hidden');
      revealResult(resultContainer);
      errorContainer.classList.add('hidden');
    } catch (err) {
      errorMessage.textContent = err instanceof Error ? err.message : 'An error occurred';
      errorContainer.classList.remove('hidden');
    }
  });

  resetBtn.addEventListener('click', () => {
    participantsList.value = '';
    numGroups.value = '3';
    peoplePerGroup.value = '2';
    resultContainer.classList.add('hidden');
    emptyState.classList.remove('hidden');
    errorContainer.classList.add('hidden');
    groupsDisplay.innerHTML = '';
  });
</script>
