---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-xl">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-3 text-3xl sm:text-4xl">{title}</h2>
  <p class="mt-4 text-base leading-7 text-ink-soft">{description}</p>
</div>
