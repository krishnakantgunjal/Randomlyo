---
interface Props {
  label?: string;
  class?: string;
}

const { label = 'Copy', class: className = '' } = Astro.props;

const baseClasses = 'secondary-action';
const classes = `${baseClasses} ${className}`;
---

<button 
  class={classes}
  data-copy-button
  aria-label={`Copy ${label}`}
>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
  </svg>
  <span data-copy-text>{label}</span>
</button>

<script>
  // Handle copy functionality
  const copyButtons = document.querySelectorAll('[data-copy-button]');
  
  copyButtons.forEach((button) => {
    button.addEventListener('click', async function(e) {
      e.preventDefault();
      const textSpan = this.querySelector('[data-copy-text]') as HTMLElement;
      const originalText = textSpan.textContent;
      
      // Get text to copy (from data attribute or sibling)
      let textToCopy = this.getAttribute('data-copy-text');
      if (!textToCopy) {
        // Try to find content nearby
        const target = document.querySelector('[data-result-content]');
        if (target) {
          textToCopy = target.textContent || '';
        }
      }
      
      if (!textToCopy) return;
      
      try {
        await navigator.clipboard.writeText(textToCopy);
        textSpan.textContent = 'Copied!';
        setTimeout(() => {
          textSpan.textContent = originalText;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy:', err);
        textSpan.textContent = 'Failed';
        setTimeout(() => {
          textSpan.textContent = originalText;
        }, 2000);
      }
    });
  });
</script>
