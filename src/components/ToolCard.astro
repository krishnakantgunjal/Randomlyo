---
import ToolIcon from './ToolIcon.astro';
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
  accent?: 'blue' | 'soft' | 'plain';
}

const { tool, accent = 'plain' } = Astro.props;
const accentClasses = {
  blue: 'bg-ink text-white border-ink hover:border-brand-deep',
  soft: 'bg-wash border-wash hover:border-brand-deep',
  plain: 'bg-white border-line hover:border-brand-deep',
};
---

<a href={tool.url} class={`group relative flex min-h-44 flex-col justify-between border p-5 transition-colors ${accentClasses[accent]}`}>
  <div class="flex items-start justify-between gap-4">
    <ToolIcon name={tool.icon} class={accent === 'blue' ? 'bg-white/10' : ''} />
    <span class={`text-lg transition-transform group-hover:translate-x-1 ${accent === 'blue' ? 'text-brand' : 'text-brand-deep'}`} aria-hidden="true">-&gt;</span>
  </div>
  <div>
    <h3 class="mt-7 text-lg font-bold">{tool.name}</h3>
    <p class={`mt-1 text-sm leading-5 ${accent === 'blue' ? 'text-white/70' : 'text-ink-soft'}`}>{tool.description}</p>
  </div>
</a>
