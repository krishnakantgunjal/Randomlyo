{
  "schema": {
    "id": "unique string identifier",
    "type": "truth | dare",
    "text": "the prompt text; use {player} or {player2} as placeholders for Player Mode name substitution",
    "who": "array — which relationship types this fits: friends | couple | family | classmates | coworkers",
    "tone": "array — funny | chill | deep | chaotic | flirty | embarrassing",
    "intensity": "mild | medium | wild",
    "setting": "array — party | sleepover | roadtrip | date | online | college (omit or use ['any'] if setting-agnostic)",
    "allAgesSafe": "boolean — true only if appropriate for under-18 age range selection",
    "physical": "boolean, dares only — true if it requires movement/space/props; false if purely verbal/seated (needed for 'online' and 'roadtrip' filtering)",
    "playerSlots": "0, 1, or 2 — how many {player} placeholders this text uses"
  },
  "prompts": [
    { "id": "t001", "type": "truth", "text": "What's the most embarrassing thing you've searched on your phone this month?", "who": ["friends","classmates","coworkers"], "tone": ["funny","embarrassing"], "intensity": "mild", "setting": ["any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t002", "type": "truth", "text": "Who in this group would survive the shortest without their phone?", "who": ["friends","classmates","coworkers"], "tone": ["funny","chaotic"], "intensity": "medium", "setting": ["party","college","sleepover"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t003", "type": "truth", "text": "What's a lie you told recently that you never got caught for?", "who": ["friends","family","classmates"], "tone": ["chaotic","embarrassing"], "intensity": "medium", "setting": ["any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t004", "type": "truth", "text": "If you had to swap lives with one person in this group for a week, who would it be and why?", "who": ["friends","classmates","coworkers"], "tone": ["chill","funny"], "intensity": "mild", "setting": ["any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t005", "type": "truth", "text": "What's the pettiest reason you've ever been mad at someone?", "who": ["friends","family"], "tone": ["funny","chaotic"], "intensity": "medium", "setting": ["any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t006", "type": "truth", "text": "What's something you pretend to understand but actually don't?", "who": ["friends","classmates","coworkers"], "tone": ["funny","chill"], "intensity": "mild", "setting": ["any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t007", "type": "truth", "text": "What's the most trouble you've ever gotten into as a kid?", "who": ["friends","family","classmates"], "tone": ["funny","embarrassing"], "intensity": "mild", "setting": ["any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t008", "type": "truth", "text": "Who would you trust to plan your entire birthday party with zero input from you — {player} or yourself?", "who": ["friends","classmates"], "tone": ["funny"], "intensity": "mild", "setting": ["party","college"], "allAgesSafe": true, "playerSlots": 1 },
    { "id": "t009", "type": "truth", "text": "What's a fear you've never told anyone in this room about?", "who": ["friends","couple"], "tone": ["deep"], "intensity": "medium", "setting": ["sleepover","date"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t010", "type": "truth", "text": "What's one thing about yourself you're actively trying to change?", "who": ["friends","couple","family"], "tone": ["deep","chill"], "intensity": "medium", "setting": ["any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t011", "type": "truth", "text": "What's the most awkward interaction you've had with a stranger?", "who": ["friends","classmates","coworkers"], "tone": ["embarrassing","funny"], "intensity": "mild", "setting": ["any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t012", "type": "truth", "text": "If this group had to vote someone off an island, who's going first and why?", "who": ["friends","classmates"], "tone": ["chaotic","funny"], "intensity": "medium", "setting": ["party","roadtrip"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t013", "type": "truth", "text": "What's a compliment you received once that you still think about?", "who": ["friends","couple","family"], "tone": ["deep","chill"], "intensity": "mild", "setting": ["any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t014", "type": "truth", "text": "What's the weirdest thing you do when you're home alone?", "who": ["friends","family"], "tone": ["funny","embarrassing"], "intensity": "medium", "setting": ["sleepover","any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t015", "type": "truth", "text": "Between you and {player}, who's more likely to accidentally start an argument at a party?", "who": ["friends","classmates"], "tone": ["chaotic","funny"], "intensity": "medium", "setting": ["party"], "allAgesSafe": true, "playerSlots": 1 },
    { "id": "t016", "type": "truth", "text": "What's the last thing you Googled that you'd be mildly embarrassed if someone saw?", "who": ["friends","coworkers"], "tone": ["funny","embarrassing"], "intensity": "medium", "setting": ["online","any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t017", "type": "truth", "text": "What's a relationship (romantic or not) you handled badly and would do differently now?", "who": ["couple","friends"], "tone": ["deep"], "intensity": "wild", "setting": ["date","sleepover"], "allAgesSafe": false, "playerSlots": 0 },
    { "id": "t018", "type": "truth", "text": "Who's the last person you thought about right before falling asleep?", "who": ["couple","friends"], "tone": ["flirty","deep"], "intensity": "medium", "setting": ["date","sleepover"], "allAgesSafe": false, "playerSlots": 0 },
    { "id": "t019", "type": "truth", "text": "What's a habit of your partner's (or crush's) that secretly annoys you a little?", "who": ["couple"], "tone": ["funny","flirty"], "intensity": "medium", "setting": ["date"], "allAgesSafe": false, "playerSlots": 0 },
    { "id": "t020", "type": "truth", "text": "What's the most chaotic thing that's happened in a work meeting you've been part of?", "who": ["coworkers"], "tone": ["funny","chaotic"], "intensity": "mild", "setting": ["any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t021", "type": "truth", "text": "If you could un-send one message you've ever sent, which one and why?", "who": ["friends","couple","coworkers"], "tone": ["embarrassing","deep"], "intensity": "medium", "setting": ["any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t022", "type": "truth", "text": "What's a class or subject you completely faked understanding to pass?", "who": ["classmates","friends"], "tone": ["funny"], "intensity": "mild", "setting": ["college","any"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t023", "type": "truth", "text": "What's something you've never admitted out loud until right now?", "who": ["friends","family","couple"], "tone": ["deep","chaotic"], "intensity": "wild", "setting": ["sleepover","date"], "allAgesSafe": false, "playerSlots": 0 },
    { "id": "t024", "type": "truth", "text": "What's the most impulsive decision you've made on a trip?", "who": ["friends"], "tone": ["chaotic","funny"], "intensity": "medium", "setting": ["roadtrip"], "allAgesSafe": true, "playerSlots": 0 },
    { "id": "t025", "type": "truth", "text": "Who do you think would win in a fight between {player} and {player2}, and why?", "who": ["friends","classmates"], "tone": ["chaotic","funny"], "intensity": "mild", "setting": ["party","roadtrip"], "allAgesSafe": true, "playerSlots": 2 },

    { "id": "d001", "type": "dare", "text": "Do your best impression of {player} for the next 60 seconds.", "who": ["friends","classmates","coworkers"], "tone": ["funny","chaotic"], "intensity": "mild", "setting": ["party","sleepover","college"], "allAgesSafe": true, "physical": false, "playerSlots": 1 },
    { "id": "d002", "type": "dare", "text": "Let the group pick your profile picture on any one app for the next hour.", "who": ["friends","classmates"], "tone": ["chaotic","funny"], "intensity": "medium", "setting": ["party","college"], "allAgesSafe": true, "physical": false, "playerSlots": 0 },
    { "id": "d003", "type": "dare", "text": "Speak in an accent of the group's choosing for the next three rounds.", "who": ["friends","classmates","coworkers"], "tone": ["funny"], "intensity": "mild", "setting": ["any"], "allAgesSafe": true, "physical": false, "playerSlots": 0 },
    { "id": "d004", "type": "dare", "text": "Text the 5th contact in your phone \"I just found something of yours\" and show the group the reply.", "who": ["friends"], "tone": ["chaotic","funny"], "intensity": "wild", "setting": ["party","sleepover"], "allAgesSafe": false, "physical": false, "playerSlots": 0 },
    { "id": "d005", "type": "dare", "text": "Let {player} draw something on your hand with a pen, no vetoes.", "who": ["friends","classmates"], "tone": ["chaotic","funny"], "intensity": "medium", "setting": ["party","sleepover","college"], "allAgesSafe": true, "physical": true, "playerSlots": 1 },
    { "id": "d006", "type": "dare", "text": "Do 15 jumping jacks while narrating them like a sports commentator.", "who": ["friends","classmates"], "tone": ["funny","chaotic"], "intensity": "mild", "setting": ["party","sleepover"], "allAgesSafe": true, "physical": true, "playerSlots": 0 },
    { "id": "d007", "type": "dare", "text": "Send a voice message singing 'Happy Birthday' to a random contact, regardless of whether it's their birthday.", "who": ["friends"], "tone": ["chaotic"], "intensity": "wild", "setting": ["party"], "allAgesSafe": false, "physical": false, "playerSlots": 0 },
    { "id": "d008", "type": "dare", "text": "Let the group rename you in this chat/call for the rest of the game.", "who": ["friends","classmates","coworkers"], "tone": ["funny"], "intensity": "mild", "setting": ["online","any"], "allAgesSafe": true, "physical": false, "playerSlots": 0 },
    { "id": "d009", "type": "dare", "text": "Attempt to say the alphabet backwards in under 20 seconds.", "who": ["friends","classmates","coworkers"], "tone": ["funny","chill"], "intensity": "mild", "setting": ["any"], "allAgesSafe": true, "physical": false, "playerSlots": 0 },
    { "id": "d010", "type": "dare", "text": "Let {player} pick your next song/video to watch together, no skipping.", "who": ["friends","couple"], "tone": ["chill","chaotic"], "intensity": "mild", "setting": ["sleepover","date","online"], "allAgesSafe": true, "physical": false, "playerSlots": 1 },
    { "id": "d011", "type": "dare", "text": "Do your best 30-second stand-up bit about the most boring thing in this room.", "who": ["friends","classmates"], "tone": ["funny"], "intensity": "medium", "setting": ["party","college"], "allAgesSafe": true, "physical": false, "playerSlots": 0 },
    { "id": "d012", "type": "dare", "text": "Let the group choose one person for you to imitate for the next two minutes.", "who": ["friends","classmates"], "tone": ["funny","chaotic"], "intensity": "medium", "setting": ["party","college"], "allAgesSafe": true, "physical": false, "playerSlots": 0 },
    { "id": "d013", "type": "dare", "text": "Try to make {player} laugh in the next 60 seconds without touching them.", "who": ["friends","couple"], "tone": ["funny","flirty"], "intensity": "medium", "setting": ["party","date","sleepover"], "allAgesSafe": true, "physical": true, "playerSlots": 1 },
    { "id": "d014", "type": "dare", "text": "Post (or pretend to post) the most recent photo in your camera roll to the group.", "who": ["friends"], "tone": ["chaotic","embarrassing"], "intensity": "wild", "setting": ["sleepover","party"], "allAgesSafe": false, "physical": false, "playerSlots": 0 },
    { "id": "d015", "type": "dare", "text": "Freestyle a 15-second rap about the person to your left.", "who": ["friends","classmates"], "tone": ["funny","chaotic"], "intensity": "medium", "setting": ["party","college"], "allAgesSafe": true, "physical": false, "playerSlots": 0 },
    { "id": "d016", "type": "dare", "text": "Let the group give you a new nickname you have to answer to for the rest of the trip.", "who": ["friends"], "tone": ["funny"], "intensity": "mild", "setting": ["roadtrip"], "allAgesSafe": true, "physical": false, "playerSlots": 0 },
    { "id": "d017", "type": "dare", "text": "Balance a spoon on your nose for 20 seconds.", "who": ["friends","family"], "tone": ["funny"], "intensity": "mild", "setting": ["party","sleepover"], "allAgesSafe": true, "physical": true, "playerSlots": 0 },
    { "id": "d018", "type": "dare", "text": "Describe your ideal date night without saying any names, and let the group guess who you're picturing.", "who": ["couple","friends"], "tone": ["flirty","funny"], "intensity": "medium", "setting": ["date","party"], "allAgesSafe": false, "physical": false, "playerSlots": 0 },
    { "id": "d019", "type": "dare", "text": "Give {player} a genuine, specific compliment you've never said out loud before.", "who": ["friends","couple","family"], "tone": ["deep","chill"], "intensity": "mild", "setting": ["any"], "allAgesSafe": true, "physical": false, "playerSlots": 1 },
    { "id": "d020", "type": "dare", "text": "Let the group pick an emoji combo you have to use as your status for the next hour.", "who": ["friends","classmates","coworkers"], "tone": ["funny"], "intensity": "mild", "setting": ["online","any"], "allAgesSafe": true, "physical": false, "playerSlots": 0 },
    { "id": "d021", "type": "dare", "text": "Act out your most embarrassing memory as a silent movie — no words, just gestures.", "who": ["friends"], "tone": ["funny","embarrassing"], "intensity": "wild", "setting": ["party","sleepover"], "allAgesSafe": true, "physical": true, "playerSlots": 0 },
    { "id": "d022", "type": "dare", "text": "Hold a straight face while {player} tries to make you laugh for 30 seconds — if you laugh, take a mild penalty of the group's choosing.", "who": ["friends","classmates"], "tone": ["funny","chaotic"], "intensity": "medium", "setting": ["party","college"], "allAgesSafe": true, "physical": true, "playerSlots": 1 },
    { "id": "d023", "type": "dare", "text": "Let the group write your out-of-office message for tomorrow.", "who": ["coworkers"], "tone": ["funny","chaotic"], "intensity": "medium", "setting": ["any"], "allAgesSafe": true, "physical": false, "playerSlots": 0 },
    { "id": "d024", "type": "dare", "text": "Do your impression of how {player} orders food at a restaurant.", "who": ["friends","classmates"], "tone": ["funny"], "intensity": "mild", "setting": ["roadtrip","party"], "allAgesSafe": true, "physical": false, "playerSlots": 1 },
    { "id": "d025", "type": "dare", "text": "Whisper the cheesiest pickup line you can think of to {player}, then immediately explain why it's terrible.", "who": ["couple","friends"], "tone": ["flirty","funny"], "intensity": "medium", "setting": ["date","party"], "allAgesSafe": false, "physical": true, "playerSlots": 1 }
