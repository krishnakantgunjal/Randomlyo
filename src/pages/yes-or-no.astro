---
import Layout from '../layouts/Layout.astro';
import ToolLayout from '../components/ToolLayout.astro';
import ResultDisplay from '../components/ResultDisplay.astro';
import CopyButton from '../components/CopyButton.astro';

const title = 'Yes or No - Get a Random Decision | Randomlyo';
const description = 'Ask a yes or no question and get a random decision instantly. Free and simple.';
---

<Layout title={title} description={description}>
  <ToolLayout
    title="Yes or No"
    description="Ask any yes or no question and get a random answer."
    toolId="yesOrNo"
  >
    <div class="grid items-start gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <section class="surface p-5 sm:p-7" aria-labelledby="yesno-question">
        <p class="eyebrow">Your question</p>
        <h2 id="yesno-question" class="mt-2 text-xl">Ask anything</h2>

        <label class="mt-6 block text-sm font-bold text-ink-soft" for="question">
          Question (optional)
          <input
            id="question"
            type="text"
            placeholder="e.g. Should we go out today?"
            class="mt-2 min-h-11 w-full rounded-xl border border-line bg-white px-3 text-sm text-ink placeholder:text-ink-soft/60"
          />
        </label>

        <button id="decideBtn" type="button" class="primary-action mt-7 w-full">Decide <span aria-hidden="true">-&gt;</span></button>
        <button id="resetBtn" type="button" class="mt-4 w-full text-sm font-bold text-ink-soft underline decoration-line underline-offset-4 hover:text-ink">Reset</button>
      </section>

      <section class="surface flex min-h-[25rem] flex-col justify-center bg-white p-5 text-center sm:p-8" aria-live="polite">
        <p class="eyebrow">The answer</p>

        <div id="emptyState">
          <p class="mt-5 text-5xl" aria-hidden="true">?</p>
          <p class="mt-4 text-sm text-ink-soft">Your answer will appear here.</p>
        </div>

        <div id="resultContainer" class="mt-6 hidden rounded-xl">
          <ResultDisplay
            title="Answer"
            result=""
          >
            <CopyButton label="Copy Answer" />
          </ResultDisplay>
        </div>

        <div id="statsContainer" class="mt-9 hidden grid grid-cols-2 gap-3 border-t border-line pt-6 text-sm">
          <div>
            <p class="text-ink-soft">Yes</p>
            <p id="yesCount" class="mt-1 text-2xl font-bold">0</p>
          </div>
          <div>
            <p class="text-ink-soft">No</p>
            <p id="noCount" class="mt-1 text-2xl font-bold">0</p>
          </div>
        </div>
      </section>
    </div>

    <!-- Kept for search engines; the workspace itself is a two-panel layout. -->
    <div class="mx-auto mt-12 max-w-2xl">
      <!-- Common Uses -->
      <section class="legacy-section mb-12">
        <h2 class="text-2xl font-bold mb-6">Common Uses</h2>
        <ul class="space-y-3 text-ink-soft">
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Should I try something new?</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Is this a good idea?</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Will it rain today?</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Should I buy this?</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Is the universe telling me yes or no?</span>
          </li>
        </ul>
      </section>

      <!-- FAQ -->
      <section class="legacy-section">
        <h2 class="text-2xl font-bold mb-6">Frequently Asked Questions</h2>
        <div class="space-y-6">
          <div>
            <h3 class="font-bold mb-2">Is this actually random?</h3>
            <p class="text-ink-soft">Yes, it uses cryptographic randomization with 50% probability for yes and 50% for no.</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Do I have to ask a question?</h3>
            <p class="text-ink-soft">No, you can leave the question blank. Just click Decide and you'll get a yes or no answer.</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Should I actually make decisions this way?</h3>
            <p class="text-ink-soft">It's fun to use, but for important decisions, always think things through carefully!</p>
          </div>
        </div>
      </section>
    </div>
  </ToolLayout>
</Layout>

<script>
  import { flipCoin } from '../lib/random';
  import { revealResult } from '../lib/effects';

  const questionInput = document.getElementById('question') as HTMLInputElement;
  const decideBtn = document.getElementById('decideBtn') as HTMLButtonElement;
  const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;
  const resultContainer = document.getElementById('resultContainer') as HTMLElement;
  const emptyState = document.getElementById('emptyState') as HTMLElement;
  const statsContainer = document.getElementById('statsContainer') as HTMLElement;
  const yesCount = document.getElementById('yesCount') as HTMLElement;
  const noCount = document.getElementById('noCount') as HTMLElement;

  let yesCounter = 0;
  let noCounter = 0;

  decideBtn.addEventListener('click', () => {
    const isYes = flipCoin();
    const answer = isYes ? 'Yes' : 'No';

    const resultElement = resultContainer.querySelector('[data-result-content]');
    if (resultElement) {
      resultElement.textContent = answer;
    }
    emptyState.classList.add('hidden');
    revealResult(resultContainer, { celebrate: true });

    if (isYes) {
      yesCounter++;
      yesCount.textContent = yesCounter.toString();
    } else {
      noCounter++;
      noCount.textContent = noCounter.toString();
    }

    statsContainer.classList.remove('hidden');
  });

  resetBtn.addEventListener('click', () => {
    questionInput.value = '';
    resultContainer.classList.add('hidden');
    emptyState.classList.remove('hidden');
    statsContainer.classList.add('hidden');
    yesCounter = 0;
    noCounter = 0;
    yesCount.textContent = '0';
    noCount.textContent = '0';
  });
</script>
