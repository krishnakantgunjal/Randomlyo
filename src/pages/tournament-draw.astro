---
import Layout from '../layouts/Layout.astro';
import ToolLayout from '../components/ToolLayout.astro';
import ListInput from '../components/ListInput.astro';
import {
  champion,
  createBracket,
  bracketProgress,
  findMatch,
  getDisplayRounds,
  roundName,
  setWinner,
  type Bracket,
  type BracketMatch,
} from '../lib/bracket';

const title = 'Tournament Draw — Single-Elimination Brackets | Randomlyo';
const description = 'Create a fair single-elimination bracket with random seeding, byes, and live winner progression.';
---

<Layout title={title} description={description}>
  <ToolLayout title="Tournament Draw" description="Build a single-elimination bracket, then advance each winner toward the championship." toolId="tournamentDraw">
    <div class="tournament-layout">
      <!-- PARTICIPANTS -->
      <section class="tournament-panel" aria-labelledby="participant-heading">
        <div class="panel-eyebrow-wrap">
          <p class="eyebrow">Who is competing?</p>
          <h2 id="participant-heading" class="tournament-panel-title">Participants</h2>
        </div>

        <p class="participant-description">Add players or teams below. Works best with an even number — 2 to 32.</p>

        <div class="participant-input-wrap">
          <ListInput
            id="participantsList"
            defaultValue=""
            placeholder="Alice, Bob, Charlie, Dana"
            entryLabel="Add a participant, then press Enter"
            mode="chips"
          />
        </div>

        <div class="participant-actions">
          <button id="generateBtn" type="button" class="primary-action tournament-generate">
            <span class="btn-icon" aria-hidden="true">🎲</span>
            <span>Draw matchups</span>
          </button>
          <button id="resetBtn" type="button" class="secondary-action tournament-reset">Reset</button>
        </div>

        <p id="errorContainer" class="tournament-error hidden" role="alert">
          <span id="errorMessage"></span>
        </p>
      </section>

      <!-- BRACKET -->
      <section class="bracket-panel surface" aria-labelledby="bracket-heading">
        <div class="bracket-panel-header">
          <div>
            <p class="eyebrow">Single elimination</p>
            <h2 id="bracket-heading" class="bracket-panel-title">Tournament bracket</h2>
          </div>
          <div class="bracket-header-right">
            <div class="relative">
              <button id="downloadBtn" type="button" class="download-btn">Download bracket ▾</button>
              <div id="downloadMenu" class="download-menu hidden">
                <button id="downloadPng" type="button" class="download-item">PNG image</button>
                <button id="downloadPdf" type="button" class="download-item">PDF</button>
              </div>
            </div>
            <span id="progressLabel" class="progress-label hidden" aria-live="polite"></span>
          </div>
        </div>

        <div id="championPanel" class="champion-panel hidden" aria-live="polite">
          <div class="champion-badge">
            <span class="champion-icon" aria-hidden="true">🏆</span>
            <div class="champion-label">Champion</div>
          </div>
          <strong id="championName" class="champion-value"></strong>
        </div>

        <div id="emptyState" class="bracket-empty">
          <span class="bracket-empty-icon" aria-hidden="true">🏆</span>
          <p class="bracket-empty-title">Your bracket will appear here.</p>
          <span class="bracket-empty-hint">Add participants and draw matchups to begin.</span>
        </div>

        <div id="bracketScroll" class="bracket-scroll hidden" aria-label="Tournament bracket">
          <div id="bracketStage" class="bracket-stage"></div>
        </div>
        <div id="bracketExportStage" class="bracket-export-stage hidden"></div>
      </section>
    </div>
  </ToolLayout>
</Layout>

<script>
  import { validateList } from '../lib/utils';
  import { jsPDF } from 'jspdf';
  import html2canvas from 'html2canvas';
  import {
    champion,
    createBracket,
    bracketProgress,
    findMatch,
    getDisplayRounds,
    roundName,
    setWinner,
    type Bracket,
    type BracketMatch,
  } from '../lib/bracket';

  const CARD_W = 140;
  const CARD_H = 56;
  const COLUMN_W = 160;
  const FINAL_W = 170;
  const COLUMN_GAP = 14;
  const STAGE_PAD = 24;
  const STAGE_OFFSET = 56;
  const PITCH = CARD_H + 24;

  interface BracketColumn {
    matches: BracketMatch[];
    width: number;
    kind: 'round' | 'final';
  }

  const participantsEl = document.getElementById('participantsList') as HTMLTextAreaElement;
  const generateBtn = document.getElementById('generateBtn') as HTMLButtonElement;
  const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;
  const downloadBtn = document.getElementById('downloadBtn') as HTMLButtonElement;
  const bracketScroll = document.getElementById('bracketScroll') as HTMLElement;
  const emptyState = document.getElementById('emptyState') as HTMLElement;
  const errorContainer = document.getElementById('errorContainer') as HTMLElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLElement;
  const progressLabel = document.getElementById('progressLabel') as HTMLElement;
  const championPanel = document.getElementById('championPanel') as HTMLElement;
  const championName = document.getElementById('championName') as HTMLElement;

  let currentBracket: Bracket | null = null;

  function matchTop(match: BracketMatch): number {
    const position = match.index * 2 ** (match.round + 1) + 2 ** match.round;
    return ((position - 1) * PITCH) / 2;
  }

  function firstRoundCount(bracket: Bracket): number {
    return bracket.leftRounds[0]?.length ?? bracket.rightRounds[0]?.length ?? 1;
  }

  function sideHeight(bracket: Bracket): number {
    return firstRoundCount(bracket) * PITCH - 24;
  }

  function getColumns(bracket: Bracket): BracketColumn[] {
    const left = bracket.leftRounds.map((matches) => ({
      matches,
      width: COLUMN_W,
      kind: 'round' as const,
    }));
    const right = bracket.rightRounds
      .slice()
      .reverse()
      .map((matches) => ({
        matches,
        width: COLUMN_W,
        kind: 'round' as const,
      }));

    return [
      ...left,
      { matches: [bracket.final], width: FINAL_W, kind: 'final' as const },
      ...right,
    ];
  }

  function placeholderFor(match: BracketMatch, side: 0 | 1): string {
    const sourceId = match.feedsFrom[side];
    if (!sourceId) return 'Bye';
    const source = findMatch(currentBracket!, sourceId);
    return source ? `Winner of Match ${source.number}` : 'Winner';
  }

  function slotName(match: BracketMatch, side: 0 | 1): string {
    const name = side === 0 ? match.slotA : match.slotB;
    return name ?? placeholderFor(match, side);
  }

  function competitorClass(match: BracketMatch, side: 0 | 1): string {
    if (match.bye) return 'competitor competitor-bye';
    if (match.winner === side) return 'competitor competitor-winner';
    if (match.winner !== null) return 'competitor competitor-eliminated';
    return 'competitor competitor-active';
  }

  function createMatchCard(
    match: BracketMatch,
    left: number,
    top: number,
    totalRounds: number,
  ): HTMLElement {
    const card = document.createElement('article');
    card.className = `bracket-match${match.bye ? ' bracket-match-bye' : ''}`;
    card.style.left = `${left}px`;
    card.style.top = `${top}px`;

    const header = document.createElement('div');
    header.className = 'match-header';
    header.textContent = `Match ${match.number}`;
    card.appendChild(header);

    for (const side of [0, 1] as const) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = competitorClass(match, side);
      button.dataset.matchId = match.id;
      button.dataset.side = String(side);
      button.textContent = slotName(match, side);
      button.disabled = match.bye;
      button.title = match.bye
        ? 'Bye — this participant advances automatically'
        : match.winner === side
          ? 'Click to undo this result'
          : 'Click to advance this participant';
      card.appendChild(button);
    }

    if (match.bye) {
      const byeLabel = document.createElement('span');
      byeLabel.className = 'bye-label';
      byeLabel.textContent = 'Bye';
      card.appendChild(byeLabel);
    }

    return card;
  }

  function connectorPath(
    start: { x: number; y: number },
    end: { x: number; y: number },
  ): string {
    const middle = (start.x + end.x) / 2;
    return `M ${start.x} ${start.y} L ${middle} ${start.y} L ${middle} ${end.y} L ${end.x} ${end.y}`;
  }

  function renderBracketTo(bracket: Bracket, container: HTMLElement, isExport = false) {
    container.replaceChildren();
    container.className = isExport ? 'bracket-export-stage' : 'bracket-stage';
    container.style.display = '';
    container.style.placeItems = '';
    container.style.width = '';
    container.style.height = '';

    if (bracket.size === 2) {
      container.className = isExport ? 'bracket-export-stage single-match-stage' : 'bracket-stage single-match-stage';
      if (isExport) {
          container.style.width = '500px';
          container.style.height = '200px';
      } else {
          container.style.width = '100%';
          container.style.height = '190px';
          container.style.display = 'grid';
          container.style.placeItems = 'center';
      }

      const match = bracket.final;
      const card = createMatchCard(match, 0, 0, bracket.totalRounds);
      card.classList.add('single-match-card');
      card.style.position = isExport ? 'absolute' : 'relative';
      if (isExport) {
          card.style.left = '180px';
          card.style.top = '70px';
      } else {
          card.style.left = 'auto';
          card.style.top = 'auto';
      }
      container.appendChild(card);
      return;
    }

    const columns = getColumns(bracket);
    const height = sideHeight(bracket) + STAGE_OFFSET * 2;
    const width =
      STAGE_PAD * 2 +
      columns.reduce((sum, column) => sum + column.width, 0) +
      COLUMN_GAP * (columns.length - 1);

    // Add extra space for round labels above cards
    container.style.width = `${width}px`;
    container.style.height = `${height + 30}px`;

    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('class', 'connector-layer');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('width', String(width));
    svg.setAttribute('height', String(height));
    container.appendChild(svg);

    const positions = new Map<string, { x: number; y: number; match: BracketMatch }>();
    let x = STAGE_PAD;

    columns.forEach((column) => {
      const columnEl = document.createElement('div');
      columnEl.className = column.kind === 'final' ? 'bracket-round bracket-final-column' : 'bracket-round';
      columnEl.style.width = `${column.width}px`;
      columnEl.style.height = `${height}px`;

      const label = document.createElement('div');
      label.className = 'round-label';
      const match = column.matches[0];
      label.textContent = column.kind === 'final'
        ? roundName(bracket.totalRounds - 1, bracket.totalRounds)
        : roundName(match.round, bracket.totalRounds);
      columnEl.appendChild(label);

      // Push cards down so labels don't overlap
      const labelHeight = 22;

      column.matches.forEach((roundMatch) => {
        const top = column.kind === 'final'
          ? (sideHeight(bracket) - CARD_H) / 2 + 14
          : matchTop(roundMatch) + 14;
        const left = (column.width - CARD_W) / 2;
        const card = createMatchCard(roundMatch, left, top, bracket.totalRounds);
        columnEl.appendChild(card);

        positions.set(roundMatch.id, {
          x: x + left,
          y: STAGE_OFFSET + top,
          match: roundMatch,
        });
      });

      container.appendChild(columnEl);
      x += column.width + COLUMN_GAP;
    });

    for (const match of bracket.leftRounds.flat().concat(bracket.rightRounds.flat())) {
      if (!match.feedsTo) continue;
      const start = positions.get(match.id);
      const end = positions.get(match.feedsTo.matchId);
      if (!start || !end) continue;

      const startY = start.y + CARD_H / 2;
      const endY = end.y + CARD_H / 2;
      const startX = match.side === 'left' ? start.x + CARD_W : start.x;
      const endX = match.side === 'left' ? end.x : end.x + CARD_W;
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', connectorPath({ x: startX, y: startY }, { x: endX, y: endY }));
      svg.appendChild(path);
    }
  }

  function renderBracket() {
    if (!currentBracket) return;

    bracketScroll.classList.remove('hidden');
    emptyState.classList.add('hidden');

    renderBracketTo(currentBracket, bracketStage, false);
    // No scale down — bracket uses full visible width
    bracketStage.style.transform = 'none';
    bracketStage.style.transformOrigin = '';

    updateStatus();
  }

  function updateStatus() {
    if (!currentBracket) return;

    const progress = bracketProgress(currentBracket);
    progressLabel.textContent = `${progress.decided} / ${progress.total} matches decided`;
    progressLabel.classList.toggle('hidden', progress.total === 0);

    const winner = champion(currentBracket);
    championName.textContent = winner ?? '';
    championPanel.classList.toggle('hidden', !winner);
  }

  function showError(message: string) {
    errorMessage.textContent = message;
    errorContainer.classList.remove('hidden');
  }

  function clearError() {
    errorMessage.textContent = '';
    errorContainer.classList.add('hidden');
  }

  function resetTool() {
    participantsEl.value = '';
    currentBracket = null;
    bracketStage.replaceChildren();
    bracketScroll.classList.add('hidden');
    emptyState.classList.remove('hidden');
    progressLabel.classList.add('hidden');
    championPanel.classList.add('hidden');
    clearError();
  }

  generateBtn.addEventListener('click', () => {
    try {
      const result = validateList(participantsEl.value);
      if (!result.valid) throw new Error(result.error ?? 'Enter at least one participant.');
      if (result.items.length < 2 || result.items.length > 32) {
        throw new Error('Enter between 2 and 32 participants.');
      }

      currentBracket = createBracket(result.items);
      clearError();
      renderBracket();
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Unable to create this bracket.');
    }
  });

  resetBtn.addEventListener('click', resetTool);

  bracketStage.addEventListener('click', (event) => {
    const target = event.target as HTMLButtonElement;
    if (!target.matches('button[data-match-id]') || !currentBracket) return;

    const matchId = target.dataset.matchId;
    const side = Number(target.dataset.side) as 0 | 1;
    if (setWinner(currentBracket, matchId, side)) {
      renderBracket();
    }
  });

  const observer = new ResizeObserver(() => {
    if (bracketStage.scrollWidth > bracketScroll.clientWidth) {
      bracketScroll.style.overflowX = 'auto';
    } else {
      bracketScroll.style.overflowX = 'hidden';
    }
  });
  observer.observe(bracketStage);

  const downloadMenu = document.getElementById('downloadMenu') as HTMLElement;
  downloadBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    downloadMenu.classList.toggle('hidden');
  });
  document.addEventListener('click', () => downloadMenu.classList.add('hidden'));

  const bracketExportStage = document.getElementById('bracketExportStage') as HTMLElement;

  async function exportTournament(type: 'png' | 'pdf') {
      if (!currentBracket) return;

      const original = document.getElementById('bracketStage') as HTMLElement;
      const clone = original.cloneNode(true) as HTMLElement;

      const tempWrapper = document.createElement('div');
      tempWrapper.style.position = 'absolute';
      tempWrapper.style.top = '0';
      tempWrapper.style.left = '-100000px';
      tempWrapper.style.opacity = '0';
      tempWrapper.style.pointerEvents = 'none';
      tempWrapper.style.overflow = 'visible';
      tempWrapper.style.display = 'block';
      tempWrapper.appendChild(clone);
      document.body.appendChild(tempWrapper);

      try {
        clone.style.transform = 'none';
        clone.style.transformOrigin = '';
        clone.style.overflow = 'visible';
        clone.style.width = original.scrollWidth ? `${original.scrollWidth}px` : 'auto';
        clone.style.height = original.scrollHeight ? `${original.scrollHeight}px` : 'auto';
        clone.style.display = 'flex';
        clone.className = 'bracket-stage';

        const allDescendants = Array.from(clone.querySelectorAll('*'));
        let minX = Infinity;
        let minY = Infinity;
        let maxX = -Infinity;
        let maxY = -Infinity;
        allDescendants.forEach((el) => {
          const rect = (el as HTMLElement).getBoundingClientRect();
          if (rect.width === 0 && rect.height === 0) return;
          minX = Math.min(minX, rect.left);
          minY = Math.min(minY, rect.top);
          maxX = Math.max(maxX, rect.right);
          maxY = Math.max(maxY, rect.bottom);
        });
        const containerRect = clone.getBoundingClientRect();
        minX = Math.min(minX, containerRect.left);
        minY = Math.min(minY, containerRect.top);
        maxX = Math.max(maxX, containerRect.right);
        maxY = Math.max(maxY, containerRect.bottom);
        const completeWidth = Math.max(0, maxX - minX + 40);
        const completeHeight = Math.max(0, maxY - minY + 40);

        const canvas = await html2canvas(clone, {
          backgroundColor: '#ffffff',
          scale: 2,
          width: completeWidth,
          height: completeHeight,
          windowWidth: completeWidth,
          windowHeight: completeHeight,
          scrollX: 0,
          scrollY: 0,
        });

        if (type === 'png') {
          const link = document.createElement('a');
          link.download = 'tournament-bracket.png';
          link.href = canvas.toDataURL('image/png');
          link.click();
        } else {
          const imgData = canvas.toDataURL('image/png');
          const pageW = completeWidth;
          const pageH = completeHeight;
          const pdf = new jsPDF({ orientation: 'landscape', unit: 'pt', format: [pageW, pageH] });
          pdf.addImage(imgData, 'PNG', 0, 0, pageW, pageH);
          pdf.save('tournament-bracket.pdf');
        }
      } finally {
        tempWrapper.remove();
      }
  }

  document.getElementById('downloadPng')?.addEventListener('click', () => exportTournament('png'));
  document.getElementById('downloadPdf')?.addEventListener('click', () => exportTournament('pdf'));
</script>

<style is:global>
  /* ===== LAYOUT ===== */
  .tournament-layout {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 1.25rem;
  }

  /* ===== PANEL SHARED ===== */
  .tournament-panel,
  .bracket-panel {
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    background: #fff;
    box-shadow:
      0 1px 3px rgba(23, 35, 63, 0.04),
      0 8px 24px rgba(23, 35, 63, 0.05),
      0 20px 48px rgba(23, 35, 63, 0.03);
    width: 100%;
    max-width: 1200px;
    transition: box-shadow 200ms ease;
  }
  .tournament-panel { padding: 1rem 1.25rem; }
  .bracket-panel {
    padding: 0.75rem; min-width: 0;
  }

  /* ===== EYEBROW + HEADINGS ===== */
  .panel-eyebrow-wrap { margin-bottom: 0.35rem; }
  .tournament-panel-title,
  .bracket-panel-title {
    margin: 0.2rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .tournament-panel-title { font-size: 1.6rem; }

  /* ===== PARTICIPANT DESCRIPTION ===== */
  .participant-description {
    margin: 0.35rem 0 0.25rem;
    color: var(--color-ink-soft);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* ===== INPUT ===== */
  .participant-input-wrap { margin-top: 1.1rem; }
  .participant-helper {
    margin: 0.6rem 0 0;
    color: var(--color-ink-soft);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  /* ===== ACTIONS ===== */
  .participant-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .tournament-generate,
  .tournament-reset { min-height: 3rem; }
  .tournament-generate { flex: 1; }
  .tournament-reset { flex: 0 0 auto; }

  .tournament-generate:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(23,35,63,0.12); }
  .tournament-generate:active { transform: scale(0.97); }
  .tournament-reset:hover { border-color: var(--color-brand-deep); background: var(--color-wash); }

  /* ===== ERROR ===== */
  .tournament-error {
    margin: 1rem 0 0;
    border: 1px solid #f0d0d9;
    border-radius: 0.75rem;
    background: #fff0f3;
    padding: 0.75rem 0.9rem;
    color: #9f2940;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .hidden { display: none !important; }

  /* ===== BRACKET HEADER ===== */
  .bracket-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .bracket-header-right { display: flex; align-items: center; gap: 0.85rem; }

  /* ===== DOWNLOAD ===== */
  .download-btn {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-brand-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0.15rem;
    transition: color 150ms ease;
  }
  .download-btn:hover { color: var(--color-ink); }

  .download-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    width: 10.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background: #fff;
    box-shadow: 0 10px 28px rgba(23, 35, 63, 0.10);
    z-index: 50;
    overflow: hidden;
    animation: resultReveal 120ms ease both;
  }
  .download-item {
    display: block;
    width: 100%;
    padding: 0.55rem 1rem;
    text-align: left;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-ink);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background 120ms ease;
  }
  .download-item:hover { background: var(--color-wash); }

  /* ===== PROGRESS ===== */
  .progress-label {
    flex: 0 0 auto;
    border-radius: 999px;
    background: linear-gradient(135deg, #f3f6fc 0%, #e9eff8 100%);
    border: 1px solid var(--color-line);
    padding: 0.35rem 0.7rem;
    color: var(--color-ink-soft);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  /* ===== CHAMPION ===== */
  .champion-panel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin: 0.75rem auto 0;
    max-width: fit-content;
    border: 1.5px solid #f0dca8;
    border-radius: 1.1rem;
    background: linear-gradient(135deg, #fffdf5 0%, #fff9e6 100%);
    padding: 0.7rem 1.25rem;
    box-shadow: 0 6px 22px rgba(180, 132, 20, 0.10);
  }
  .champion-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
  }
  .champion-icon { font-size: 1.5rem; line-height: 1; }
  .champion-label {
    margin: 0;
    color: #a07e30;
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
  }
  .champion-value {
    display: block;
    color: var(--color-ink);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  /* ===== EMPTY STATE ===== */
  .bracket-empty {
    display: flex;
    min-height: 14rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    color: var(--color-ink-soft);
    text-align: center;
    background: linear-gradient(180deg, #fff 0%, #f9fbfe 100%);
    border-radius: 0.75rem;
  }
