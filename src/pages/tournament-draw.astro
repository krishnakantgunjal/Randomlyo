---
import Layout from '../layouts/Layout.astro';
import ToolLayout from '../components/ToolLayout.astro';
import ListInput from '../components/ListInput.astro';

const title = 'Tournament Draw - Random Matchups | Randomlyo';
const description = 'Generate random tournament matchups instantly. Perfect for competitions.';
const defaultParticipants = 'Team A, Team B, Team C, Team D, Team E, Team F, Team G, Team H';
---

<Layout title={title} description={description}>
  <ToolLayout
    title="Tournament Draw"
    description="Generate random tournament matchups."
    toolId="tournamentDraw"
  >
    <div class="grid items-start gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <section class="surface p-5 sm:p-7" aria-labelledby="tournament-field">
        <p class="eyebrow">Tournament field</p>
        <h2 id="tournament-field" class="mt-2 text-xl">Who is competing?</h2>
        <ListInput
          id="participantsList"
          defaultValue={defaultParticipants}
          placeholder="Team A, Team B, Team C"
          entryLabel="Add a participant, then press Enter"
          class="mt-5"
        />
        <p class="mt-3 text-xs text-ink-soft">Works best with an even number of participants.</p>
        <button id="generateBtn" type="button" class="primary-action mt-7 w-full">Draw matchups <span aria-hidden="true">-&gt;</span></button>
        <button id="resetBtn" type="button" class="mt-4 w-full text-sm font-bold text-ink-soft underline decoration-line underline-offset-4 hover:text-ink">Reset</button>
        <p id="errorContainer" class="mt-4 hidden border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert"><span id="errorMessage"></span></p>
      </section>

      <section class="surface min-h-[25rem] bg-white p-5 sm:p-7" aria-live="polite">
        <p class="eyebrow">Tournament bracket</p>
        <div id="emptyState" class="py-20 text-center">
          <p class="text-5xl" aria-hidden="true">🏆</p>
          <p class="mt-4 text-sm text-ink-soft">Your bracket will appear here.</p>
        </div>
        <div id="resultContainer" class="mt-5 flex gap-4 overflow-x-auto pb-4"></div>
      </section>
    </div>

    <!-- Kept for search engines; the workspace itself is a two-panel layout. -->
    <div class="mx-auto mt-12 max-w-2xl">
      <section class="legacy-section mb-12 border border-line bg-wash p-4">
        <h3 class="font-bold mb-2">Tournament Structure</h3>
        <p class="text-sm text-ink-soft">
          The current version generates a random first-round draw. After you complete Round 1, you can use this tool again with the winners to generate Round 2, and so on.
        </p>
      </section>

      <!-- Common Uses -->
      <section class="legacy-section mb-12">
        <h2 class="text-2xl font-bold mb-6">Common Uses</h2>
        <ul class="space-y-3 text-ink-soft">
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Sports tournament draws</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Esports bracket generation</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Game tournament matchups</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-brand-deep font-bold">•</span>
            <span>Competition round pairings</span>
          </li>
        </ul>
      </section>

      <!-- FAQ -->
      <section class="legacy-section">
        <h2 class="text-2xl font-bold mb-6">Frequently Asked Questions</h2>
        <div class="space-y-6">
          <div>
            <h3 class="font-bold mb-2">What if I have an odd number of participants?</h3>
            <p class="text-ink-soft">One participant will get a bye (automatic advancement). For the fairest tournament, an even number is recommended.</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Can I use this for multiple rounds?</h3>
            <p class="text-ink-soft">Yes, use it again with the Round 1 winners to generate Round 2 matchups, and so on.</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Is this a true random draw?</h3>
            <p class="text-ink-soft">Yes, participants are randomly paired using cryptographic randomization for fair matchups.</p>
          </div>
        </div>
      </section>
    </div>
  </ToolLayout>
</Layout>

<script>
  import { validateList } from '../lib/utils';
  import { shuffleArray } from '../lib/random';
  import { revealResult } from '../lib/effects';
  import {
    createBracket,
    setWinner,
    roundName,
    champion,
    type Bracket,
    MIN_PARTICIPANTS,
    MAX_PARTICIPANTS
  } from '../lib/bracket';

  const participantsList = document.getElementById('participantsList') as HTMLTextAreaElement;
  const generateBtn = document.getElementById('generateBtn') as HTMLButtonElement;
  const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;
  const resultContainer = document.getElementById('resultContainer') as HTMLElement;
  const emptyState = document.getElementById('emptyState') as HTMLElement;
  const errorContainer = document.getElementById('errorContainer') as HTMLElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLElement;

  let currentBracket: Bracket | null = null;

  function renderBracket() {
    if (!currentBracket) return;

    const champ = champion(currentBracket);

    resultContainer.innerHTML = currentBracket.rounds.map((round, rIndex) => {
      const matches = round.map((match, mIndex) => {
        const [p1, p2] = match.players;
        const isFinal = rIndex === currentBracket!.rounds.length - 1;

        const renderPlayer = (name: string | null, side: 0 | 1) => {
          if (name === null) {
            return `
              <div class="flex h-10 items-center border border-line bg-wash/50 px-3 text-xs italic text-ink-soft/70">
                ${match.round === 0 ? 'Empty' : 'Wait...'}
              </div>
            `;
          }

          const isWinner = match.winner === side;
          const isEliminated = match.winner !== null && match.winner !== side;
          const isBye = match.bye;
          const isChampion = isFinal && isWinner;

          return `
            <button
              type="button"
              data-round="${rIndex}"
              data-match="${mIndex}"
              data-side="${side}"
              class="flex h-10 w-full items-center justify-between border px-3 text-sm transition-all
                ${isWinner ? 'border-brand-deep bg-brand/10 font-bold text-ink' : 'border-line bg-white text-ink-soft'}
                ${isEliminated ? 'opacity-50 grayscale' : ''}
                ${isChampion ? 'ring-2 ring-brand-deep ring-offset-2' : ''}
                ${!isWinner && !isEliminated ? 'hover:border-brand-deep hover:bg-wash' : ''}
                ${isBye ? 'cursor-default pointer-events-none' : ''}
              "
              ${isBye ? 'disabled' : ''}
            >
              <span class="truncate">${name}</span>
              ${isChampion ? '<span class="text-xs">🏆</span>' : ''}
              ${isWinner && !isFinal ? '<span class="text-xs">→</span>' : ''}
            </button>
          `;
        };

        return `
          <div class="relative flex flex-col justify-center py-4" style="min-height: ${100 / currentBracket!.rounds[rIndex].length}%">
            <div class="surface overflow-hidden rounded shadow-sm">
              <div class="bg-wash/50 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-ink-soft/60">
                Match ${mIndex + 1}
              </div>
              <div class="divide-y divide-line">
                ${renderPlayer(p1, 0)}
                ${renderPlayer(p2, 1)}
              </div>
            </div>
          </div>
        `;
      }).join('');

      return `
        <div class="flex min-w-[180px] flex-col gap-4">
          <p class="text-center text-[10px] font-bold uppercase tracking-widest text-brand-deep">
            ${roundName(round.length)}
          </p>
          <div class="flex flex-1 flex-col">
            ${matches}
          </div>
        </div>
      `;
    }).join('');

    // Attach click listeners
    resultContainer.querySelectorAll('button[data-round]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const round = parseInt(target.dataset.round!);
        const match = parseInt(target.dataset.match!);
        const side = parseInt(target.dataset.side!) as 0 | 1;

        if (currentBracket && setWinner(currentBracket, round, match, side)) {
          renderBracket();
        }
      });
    });

    if (champ) {
      // Add a celebration state if needed
    }
  }

  generateBtn.addEventListener('click', () => {
    try {
      const validation = validateList(participantsList.value);
      if (!validation.valid) {
        errorMessage.textContent = validation.error || 'Invalid input';
        errorContainer.classList.remove('hidden');
        return;
      }

      if (validation.items.length < MIN_PARTICIPANTS) {
        throw new Error(`You need at least ${MIN_PARTICIPANTS} participants for a tournament`);
      }
      if (validation.items.length > MAX_PARTICIPANTS) {
        throw new Error(`This tool supports up to ${MAX_PARTICIPANTS} participants`);
      }

      const shuffled = shuffleArray(validation.items);
      currentBracket = createBracket(shuffled);

      emptyState.classList.add('hidden');
      resultContainer.classList.remove('hidden');
      renderBracket();
      revealResult(resultContainer);
      errorContainer.classList.add('hidden');
    } catch (err) {
      errorMessage.textContent = err instanceof Error ? err.message : 'An error occurred';
      errorContainer.classList.remove('hidden');
    }
  });

  resetBtn.addEventListener('click', () => {
    participantsList.value = '';
    resultContainer.classList.add('hidden');
    emptyState.classList.remove('hidden');
    errorContainer.classList.add('hidden');
    resultContainer.innerHTML = '';
    currentBracket = null;
  });
</script>
