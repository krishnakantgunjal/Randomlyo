---
import Layout from '../layouts/Layout.astro';
import ToolLayout from '../components/ToolLayout.astro';
import ListInput from '../components/ListInput.astro';
import {
  champion,
  createBracket,
  bracketProgress,
  findMatch,
  getDisplayRounds,
  roundName,
  setWinner,
  type Bracket,
  type BracketMatch,
} from '../lib/bracket';

const title = 'Tournament Draw — Single-Elimination Brackets | Randomlyo';
const description = 'Create a fair single-elimination bracket with random seeding, byes, and live winner progression.';
---

<Layout title={title} description={description}>
  <ToolLayout title="Tournament Draw" description="Build a single-elimination bracket, then advance each winner toward the championship." toolId="tournamentDraw">
    <div class="tournament-layout">
      <!-- PARTICIPANTS -->
      <section class="tournament-panel" aria-labelledby="participant-heading">
        <div class="panel-eyebrow-wrap">
          <p class="eyebrow">Who is competing?</p>
          <h2 id="participant-heading" class="tournament-panel-title">Participants</h2>
        </div>

        <p class="participant-description">Add players or teams below. Works best with an even number — 2 to 32.</p>

        <div class="participant-input-wrap">
          <ListInput
            id="participantsList"
            defaultValue=""
            placeholder="Alice, Bob, Charlie, Dana"
            entryLabel="Add a participant, then press Enter"
            mode="chips"
          />
        </div>

        <div class="participant-actions">
          <button id="generateBtn" type="button" class="primary-action tournament-generate">
            <span class="btn-icon" aria-hidden="true">🎲</span>
            <span>Draw matchups</span>
          </button>
          <button id="resetBtn" type="button" class="secondary-action tournament-reset">Reset</button>
        </div>

        <p id="errorContainer" class="tournament-error hidden" role="alert">
          <span id="errorMessage"></span>
        </p>
      </section>

      <!-- BRACKET -->
      <section class="bracket-panel surface" aria-labelledby="bracket-heading">
        <div class="bracket-panel-header">
          <div>
            <p class="eyebrow">Single elimination</p>
            <h2 id="bracket-heading" class="bracket-panel-title">Tournament bracket</h2>
          </div>
          <div class="bracket-header-right">
            <div class="relative">
              <button id="downloadBtn" type="button" class="download-btn">Download bracket ▾</button>
              <div id="downloadMenu" class="download-menu hidden">
                <button id="downloadPng" type="button" class="download-item">PNG image</button>
                <button id="downloadPdf" type="button" class="download-item">PDF</button>
              </div>
            </div>
            <span id="progressLabel" class="progress-label hidden" aria-live="polite"></span>
          </div>
        </div>

        <div id="championPanel" class="champion-panel hidden" aria-live="polite">
          <div class="champion-badge">
            <span class="champion-icon" aria-hidden="true">🏆</span>
            <div class="champion-label">Champion</div>
          </div>
          <strong id="championName" class="champion-value"></strong>
        </div>

        <div id="emptyState" class="bracket-empty">
          <span class="bracket-empty-icon" aria-hidden="true">🏆</span>
          <p class="bracket-empty-title">Your bracket will appear here.</p>
          <span class="bracket-empty-hint">Add participants and draw matchups to begin.</span>
        </div>

        <div id="bracketScroll" class="bracket-scroll hidden" aria-label="Tournament bracket">
          <div id="bracketStage" class="bracket-stage"></div>
        </div>
        <div id="bracketExportStage" class="bracket-export-stage hidden"></div>
      </section>
    </div>
  </ToolLayout>
</Layout>

<script>
  import { validateList } from '../lib/utils';
  import { jsPDF } from 'jspdf';
  import html2canvas from 'html2canvas';
  import {
    champion,
    createBracket,
    bracketProgress,
    findMatch,
    getDisplayRounds,
    roundName,
    setWinner,
    type Bracket,
    type BracketMatch,
  } from '../lib/bracket';

  const participantsEl = document.getElementById('participantsList') as HTMLTextAreaElement;
  const generateBtn = document.getElementById('generateBtn') as HTMLButtonElement;
  const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;
  const downloadBtn = document.getElementById('downloadBtn') as HTMLButtonElement;
  const bracketScroll = document.getElementById('bracketScroll') as HTMLElement;
  const emptyState = document.getElementById('emptyState') as HTMLElement;
  const errorContainer = document.getElementById('errorContainer') as HTMLElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLElement;
  const progressLabel = document.getElementById('progressLabel') as HTMLElement;
  const championPanel = document.getElementById('championPanel') as HTMLElement;
  const championName = document.getElementById('championName') as HTMLElement;

  let currentBracket: Bracket | null = null;

  /* ===== DATA HELPERS ===== */
  function placeholderFor(match: BracketMatch, side: 0 | 1): string {
    const sourceId = match.feedsFrom[side];
    if (!sourceId) return 'Bye';
    const source = findMatch(currentBracket!, sourceId);
    return source ? `Winner of Match ${source.number}` : 'Winner';
  }

  function slotName(match: BracketMatch, side: 0 | 1): string {
    const name = side === 0 ? match.slotA : match.slotB;
    return name ?? placeholderFor(match, side);
  }

  function competitorClass(match: BracketMatch, side: 0 | 1): string {
    if (match.bye) return 'competitor competitor-bye';
    if (match.winner === side) return 'competitor competitor-winner';
    if (match.winner !== null) return 'competitor competitor-eliminated';
    return 'competitor competitor-active';
  }

  /* ===== ROUND COLUMNS FROM DATA ===== */
  interface BracketColumn {
    label: string;
    kind: 'left-round' | 'final' | 'right-round';
    matches: BracketMatch[];
    roundNumbers: number[]; // for label display
  }

  function getColumns(bracket: Bracket): BracketColumn[] {
    const leftRounds = bracket.leftRounds.map((matches, idx) => ({
      matches,
      kind: 'left-round' as const,
      label: roundName(idx, bracket.totalRounds),
      roundNumbers: [idx],
    }));
    const rightRoundsReversed = [...bracket.rightRounds].reverse().map((matches, revIdx) => {
      const originalIdx = bracket.rightRounds.length - 1 - revIdx;
      return {
        matches,
        kind: 'right-round' as const,
        label: roundName(originalIdx, bracket.totalRounds),
        roundNumbers: [originalIdx],
      };
    });
    return [
      ...leftRounds,
      { matches: [bracket.final], kind: 'final' as const, label: 'Finals', roundNumbers: [bracket.totalRounds - 1] },
      ...rightRoundsReversed,
    ];
  }

  /* ===== CARD CREATION ===== */
  function createMatchCard(match: BracketMatch): HTMLElement {
    const card = document.createElement('article');
    card.className = `bracket-match${match.bye ? ' bracket-match-bye' : ''}`;
    card.setAttribute('data-match-id', match.id);

    const header = document.createElement('div');
    header.className = 'match-header';
    header.textContent = `Match ${match.number}`;
    card.appendChild(header);

    for (const side of [0, 1] as const) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = competitorClass(match, side);
      button.dataset.matchId = match.id;
      button.dataset.side = String(side);
      button.textContent = slotName(match, side);
      button.disabled = match.bye;
      button.title = match.bye
        ? 'Bye — this participant advances automatically'
        : match.winner === side
          ? 'Click to undo this result'
          : 'Click to advance this participant';
      card.appendChild(button);
    }

    if (match.bye) {
      const byeLabel = document.createElement('span');
      byeLabel.className = 'bye-label';
      byeLabel.textContent = 'Bye';
      card.appendChild(byeLabel);
    }
    return card;
  }

  /* ===== BRACKET GRID RENDER ===== */
  function renderBracketTo(bracket: Bracket, container: HTMLElement, isExport = false) {
    container.replaceChildren();
    container.className = isExport ? 'bracket-grid bracket-export-stage' : 'bracket-grid';
    container.style.display = 'grid';
    container.style.gap = '0';

    const columns = getColumns(bracket);
    // Dynamic column count based on data
    const colTemplate = columns.map((c) => (c.kind === 'final' ? '220px' : '200px')).join(' ');
    container.style.gridTemplateColumns = colTemplate;

    // Header row for headings
    const headerRow = document.createElement('div');
    headerRow.className = 'bracket-header-row';
    headerRow.style.display = 'contents';
    columns.forEach((col) => {
      const label = document.createElement('div');
      label.className = `round-label column-label ${col.kind}`;
      label.textContent = col.label;
      label.style.gridColumn = columns.indexOf(col) + 1;
      headerRow.appendChild(label);
    });
    container.appendChild(headerRow);

    // Find max number of matches in any column (for vertical alignment)
    const maxMatches = Math.max(...columns.map((c) => c.matches.length));

    // Create rows: one per "match slot" vertically
    for (let row = 0; row < maxMatches; row++) {
      columns.forEach((col) => {
        const cell = document.createElement('div');
        cell.className = 'bracket-cell';
        cell.style.display = 'flex';
        cell.style.justifyContent = 'center';
        cell.style.alignItems = 'center';
        cell.style.padding = '0.5rem';

        const match = col.matches[row];
        if (match) {
          const card = createMatchCard(match);
          cell.appendChild(card);
        } else {
          // Spacer cell for shorter columns to keep alignment
          const spacer = document.createElement('div');
          spacer.className = 'bracket-spacer';
          spacer.style.height = '100px';
          spacer.style.visibility = 'hidden';
          cell.appendChild(spacer);
        }
        container.appendChild(cell);
      });
    }

    // Connector SVG layer (absolute over grid)
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('class', 'connector-layer');
    svg.setAttribute('aria-hidden', 'true');
    svg.style.position = 'absolute';
    svg.style.inset = '0';
    svg.style.width = '100%';
    svg.style.height = '100%';
    svg.style.pointerEvents = 'none';
    svg.style.zIndex = '0';
    container.appendChild(svg);
  }

  /* ===== MAIN RENDER ===== */
  function renderBracket() {
    if (!currentBracket) return;
    bracketScroll.classList.remove('hidden');
    emptyState.classList.add('hidden');
    renderBracketTo(currentBracket, bracketStage, false);
    bracketStage.style.transform = 'none';
    bracketStage.style.transformOrigin = 'center top';
    updateStatus();
  }

  function updateStatus() {
    if (!currentBracket) return;
    const progress = bracketProgress(currentBracket);
    progressLabel.textContent = `${progress.decided} / ${progress.total} matches decided`;
    progressLabel.classList.toggle('hidden', progress.total === 0);
    const winner = champion(currentBracket);
    championName.textContent = winner ?? '';
    championPanel.classList.toggle('hidden', !winner);
  }

  function showError(message: string) {
    errorMessage.textContent = message;
    errorContainer.classList.remove('hidden');
  }
  function clearError() {
    errorMessage.textContent = '';
    errorContainer.classList.add('hidden');
  }
  function resetTool() {
    participantsEl.value = '';
    currentBracket = null;
    bracketStage.replaceChildren();
    bracketScroll.classList.add('hidden');
    emptyState.classList.remove('hidden');
    progressLabel.classList.add('hidden');
    championPanel.classList.add('hidden');
    clearError();
  }

  generateBtn.addEventListener('click', () => {
    try {
      const result = validateList(participantsEl.value);
      if (!result.valid) throw new Error(result.error ?? 'Enter at least one participant.');
      if (result.items.length < 2 || result.items.length > 32) {
        throw new Error('Enter between 2 and 32 participants.');
      }
      currentBracket = createBracket(result.items);
      clearError();
      renderBracket();
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Unable to create this bracket.');
    }
  });
  resetBtn.addEventListener('click', resetTool);

  bracketStage.addEventListener('click', (event) => {
    const target = event.target as HTMLButtonElement;
    if (!target.matches('button[data-match-id]') || !currentBracket) return;
    const matchId = target.dataset.matchId;
    const side = Number(target.dataset.side) as 0 | 1;
    if (setWinner(currentBracket, matchId, side)) {
      renderBracket();
    }
  });

  const observer = new ResizeObserver(() => {
    if (bracketStage.scrollWidth > bracketScroll.clientWidth) {
      bracketScroll.style.overflowX = 'auto';
    } else {
      bracketScroll.style.overflowX = 'hidden';
    }
  });
  observer.observe(bracketStage);

  const downloadMenu = document.getElementById('downloadMenu') as HTMLElement;
  downloadBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    downloadMenu.classList.toggle('hidden');
  });
  document.addEventListener('click', () => downloadMenu.classList.add('hidden'));

  const bracketExportStage = document.getElementById('bracketExportStage') as HTMLElement;

  async function exportTournament(type: 'png' | 'pdf') {
    if (!currentBracket) return;
    const original = document.getElementById('bracketStage') as HTMLElement;
    const clone = document.createElement('div');
    clone.className = 'bracket-export-stage bracket-grid';
    clone.style.display = 'grid';
    clone.style.gap = '0';
    clone.style.padding = '2rem';
    clone.style.backgroundColor = '#fff';
    clone.style.width = 'auto';
    clone.style.height = 'auto';

    // Rebuild clean export grid from data
    const columns = getColumns(currentBracket);
    const colTemplate = columns.map((c) => (c.kind === 'final' ? '220px' : '200px')).join(' ');
    clone.style.gridTemplateColumns = colTemplate;

    // Headings
    columns.forEach((col, idx) => {
      const label = document.createElement('div');
      label.className = `round-label column-label ${col.kind}`;
      label.textContent = col.label;
      label.style.gridColumn = `${idx + 1}`;
      label.style.gridRow = '1';
      clone.appendChild(label);
    });

    const maxMatches = Math.max(...columns.map((c) => c.matches.length));
    for (let row = 0; row < maxMatches; row++) {
      columns.forEach((col, idx) => {
        const cell = document.createElement('div');
        cell.style.display = 'flex';
        cell.style.justifyContent = 'center';
        cell.style.alignItems = 'center';
        cell.style.padding = '0.5rem';
        cell.style.gridColumn = `${idx + 1}`;
        cell.style.gridRow = `${row + 2}`;

        const match = col.matches[row];
        if (match) {
          const card = createMatchCard(match);
          card.style.position = 'relative';
          card.style.width = '190px';
          card.style.height = '86px';
          cell.appendChild(card);
        } else {
          const spacer = document.createElement('div');
          spacer.style.height = '86px';
          spacer.style.visibility = 'hidden';
          cell.appendChild(spacer);
        }
        clone.appendChild(cell);
      });
    }

    // Champion below final column — close gap
    const winner = champion(currentBracket);
    if (winner) {
      const championRow = document.createElement('div');
      championRow.style.gridColumn = '3';
      championRow.style.gridRow = `${maxMatches + 2}`; // immediately after last match row
      championRow.style.display = 'flex';
      championRow.style.justifyContent = 'center';
      championRow.style.alignItems = 'center';
      championRow.style.padding = '0.35rem 0 0';
      championRow.innerHTML = `
        <div class="export-champion" style="text-align:center;border:2px solid #e8c080;border-radius:1rem;background:linear-gradient(135deg,#fffdf5,#fdf5e6);padding:0.9rem 1.5rem;box-shadow:0 4px 14px rgba(180,132,20,0.08);">
          <div style="font-size:1.3rem;line-height:1;">🏆</div>
          <div style="font-size:0.58rem;font-weight:900;letter-spacing:0.14em;text-transform:uppercase;color:#a07e30;margin-top:0.2rem;">Champion</div>
          <strong style="display:block;color:#17233f;font-size:1.05rem;font-weight:800;margin-top:0.3rem;">${winner}</strong>
        </div>
      `;
      clone.appendChild(championRow);
    }

    const tempWrapper = document.createElement('div');
    tempWrapper.style.position = 'absolute';
    tempWrapper.style.top = '0';
    tempWrapper.style.left = '-100000px';
    tempWrapper.style.opacity = '0';
    tempWrapper.style.pointerEvents = 'none';
    tempWrapper.style.overflow = 'visible';
    tempWrapper.style.display = 'block';
    tempWrapper.appendChild(clone);
    document.body.appendChild(tempWrapper);

    try {
      await new Promise((r) => setTimeout(r, 50));

      // Measure card positions for connector drawing
      const cards = Array.from(clone.querySelectorAll('.bracket-match')) as HTMLElement[];
      const cardRects: { x: number; y: number; matchId: string }[] = [];
      cards.forEach((card) => {
        const rect = card.getBoundingClientRect();
        const matchId = card.getAttribute('data-match-id');
        cardRects.push({ x: rect.left + rect.width / 2, y: rect.top + rect.height / 2, matchId: matchId || '' });
      });

      // Build connector SVG based on feedsTo data
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('class', 'connector-layer');
      svg.setAttribute('aria-hidden', 'true');
      svg.style.position = 'absolute';
      svg.style.inset = '0';
      svg.style.width = '100%';
      svg.style.height = '100%';
      svg.style.pointerEvents = 'none';
      svg.style.zIndex = '0';
      svg.style.overflow = 'visible';

      const rect = clone.getBoundingClientRect();
      const positionsMap = new Map<string, { x: number; y: number; w: number; h: number }>();
      cards.forEach((card) => {
        const r = card.getBoundingClientRect();
        const id = card.getAttribute('data-match-id');
        if (id) positionsMap.set(id, { x: r.left - rect.left, y: r.top - rect.top, w: r.width, h: r.height });
      });

      for (const col of columns) {
        for (const match of col.matches) {
          if (match.feedsTo && match.id && match.feedsTo.matchId) {
            const start = positionsMap.get(match.id);
            const end = positionsMap.get(match.feedsTo.matchId);
            if (start && end) {
              const sx = start.x + start.w / 2;
              const sy = start.y + start.h / 2;
              const ex = end.x + end.w / 2;
              const ey = end.y + end.h / 2;
              const mx = (sx + ex) / 2;
              const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
              const d = `M ${sx} ${sy} L ${mx} ${sy} L ${mx} ${ey} L ${ex} ${ey}`;
              path.setAttribute('d', d);
              path.setAttribute('stroke', '#b8c4db');
              path.setAttribute('stroke-width', '2');
              path.setAttribute('fill', 'none');
              path.setAttribute('stroke-linecap', 'round');
              path.setAttribute('stroke-linejoin', 'round');
              svg.appendChild(path);
            }
          }
        }
      }
      clone.appendChild(svg);

      await new Promise((r) => setTimeout(r, 50));
      const completeWidth = Math.max(1200, clone.scrollWidth);
      const completeHeight = Math.max(600, clone.scrollHeight);
      const canvas = await html2canvas(clone, {
        backgroundColor: '#ffffff',
        scale: 2,
        width: completeWidth,
        height: completeHeight,
        windowWidth: completeWidth,
        windowHeight: completeHeight,
        scrollX: 0,
        scrollY: 0,
      });

      if (type === 'png') {
        const link = document.createElement('a');
        link.download = 'tournament-bracket.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      } else {
        const imgData = canvas.toDataURL('image/png');
        const pdf = new jsPDF({ orientation: 'landscape', unit: 'pt', format: [completeWidth / 2, completeHeight / 2] });
        pdf.addImage(imgData, 'PNG', 0, 0, completeWidth / 2, completeHeight / 2);
        pdf.save('tournament-bracket.pdf');
      }
    } finally {
      tempWrapper.remove();
    }
  }

  document.getElementById('downloadPng')?.addEventListener('click', () => exportTournament('png'));
  document.getElementById('downloadPdf')?.addEventListener('click', () => exportTournament('pdf'));
</script>

<style is:global>
  /* ===== LAYOUT ===== */
  .tournament-layout {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 1.25rem;
  }

  .tournament-panel,
  .bracket-panel {
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    background: #fff;
    box-shadow:
      0 1px 3px rgba(23, 35, 63, 0.04),
      0 8px 24px rgba(23, 35, 63, 0.05),
      0 20px 48px rgba(23, 35, 63, 0.03);
    width: 100%;
    max-width: 1200px;
    transition: box-shadow 200ms ease;
  }
  .tournament-panel { padding: 1rem 1.25rem; }
  .bracket-panel {
    padding: 1rem;
    min-width: 0;
  }

  /* ===== EYEBROW + HEADINGS ===== */
  .panel-eyebrow-wrap { margin-bottom: 0.35rem; }
  .tournament-panel-title,
  .bracket-panel-title {
    margin: 0.2rem 0 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .tournament-panel-title { font-size: 1.6rem; }

  /* ===== PARTICIPANT DESCRIPTION ===== */
  .participant-description {
    margin: 0.35rem 0 0.25rem;
    color: var(--color-ink-soft);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* ===== INPUT ===== */
  .participant-input-wrap { margin-top: 1.1rem; }
  .participant-helper {
    margin: 0.6rem 0 0;
    color: var(--color-ink-soft);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  /* ===== ACTIONS ===== */
  .participant-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .tournament-generate,
  .tournament-reset { min-height: 3rem; }
  .tournament-generate { flex: 1; }
  .tournament-reset { flex: 0 0 auto; }

  .tournament-generate:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(23,35,63,0.12); }
  .tournament-generate:active { transform: scale(0.97); }
  .tournament-reset:hover { border-color: var(--color-brand-deep); background: var(--color-wash); }

  /* ===== ERROR ===== */
  .tournament-error {
    margin: 1rem 0 0;
    border: 1px solid #f0d0d9;
    border-radius: 0.75rem;
    background: #fff0f3;
    padding: 0.75rem 0.9rem;
    color: #9f2940;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .hidden { display: none !important; }

  /* ===== BRACKET HEADER ===== */
  .bracket-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .bracket-header-right { display: flex; align-items: center; gap: 0.85rem; }

  /* ===== DOWNLOAD ===== */
  .download-btn {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-brand-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0.15rem;
    transition: color 150ms ease;
  }
  .download-btn:hover { color: var(--color-ink); }

  .download-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    width: 10.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background: #fff;
    box-shadow: 0 10px 28px rgba(23, 35, 63, 0.10);
    z-index: 50;
    overflow: hidden;
    animation: resultReveal 120ms ease both;
  }
  .download-item {
    display: block;
    width: 100%;
    padding: 0.55rem 1rem;
    text-align: left;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-ink);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background 120ms ease;
  }
  .download-item:hover { background: var(--color-wash); }

  /* ===== PROGRESS ===== */
  .progress-label {
    flex: 0 0 auto;
    border-radius: 999px;
    background: linear-gradient(135deg, #f3f6fc 0%, #e9eff8 100%);
    border: 1px solid var(--color-line);
    padding: 0.35rem 0.7rem;
