---
import Layout from '../layouts/Layout.astro';
import ToolLayout from '../components/ToolLayout.astro';
import {
  CUBE_SIDES,
  DIE_FACES,
  FACE_LAYOUT,
  MAX_DICE,
  PIP_LAYOUT,
  pipColumn,
  pipRow,
} from '../lib/dice';

const title = 'Dice Roller - Roll Dice Online in 3D | Randomlyo';
const description = 'Roll up to six dice at once with real 3D animation. D6, D20, D100, and more. Perfect for games.';
---

<Layout title={title} description={description}>
  <ToolLayout
    title="Dice Roller"
    description="Roll up to six dice at once, with real 3D animation."
    toolId="diceRoller"
  >
    <div class="grid items-start gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <section class="surface p-5 sm:p-7" aria-labelledby="dice-settings">
        <p class="eyebrow">Dice setup</p>
        <h2 id="dice-settings" class="mt-2 text-xl">Choose your dice</h2>

        <label class="mt-6 block text-sm font-bold text-ink-soft" for="numDice">
          Number of dice
          <input
            id="numDice"
            type="number"
            min="1"
            max={MAX_DICE}
            value="1"
            class="mt-2 min-h-11 w-full rounded-xl border border-line bg-white px-3 text-ink"
          />
        </label>
        <p class="mt-2 text-xs text-ink-soft">Up to {MAX_DICE} at a time.</p>

        <label class="mt-5 block text-sm font-bold text-ink-soft" for="diceType">
          Dice type
          <select
            id="diceType"
            class="mt-2 min-h-11 w-full rounded-xl border border-line bg-white px-3 text-sm font-semibold text-ink"
          >
            <option value={CUBE_SIDES}>D6 (6 sides)</option>
            <option value="4">D4 (4 sides)</option>
            <option value="8">D8 (8 sides)</option>
            <option value="10">D10 (10 sides)</option>
            <option value="12">D12 (12 sides)</option>
            <option value="20">D20 (20 sides)</option>
            <option value="100">D100 (100 sides)</option>
          </select>
        </label>
        <p class="mt-2 text-xs text-ink-soft">D6 rolls land on a real 3D cube.</p>

        <button id="rollBtn" type="button" class="primary-action mt-7 w-full">Roll dice <span aria-hidden="true">-&gt;</span></button>
        <button id="resetBtn" type="button" class="mt-4 w-full text-sm font-bold text-ink-soft underline decoration-line underline-offset-4 hover:text-ink">Reset</button>
        <p id="errorMessage" class="mt-4 hidden border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert"></p>
      </section>

      <section class="surface flex min-h-[25rem] flex-col justify-center bg-white p-5 text-center sm:p-8" aria-live="polite">
        <p class="eyebrow">The roll</p>
        <div id="emptyState">
          <p class="mt-5 text-5xl" aria-hidden="true">🎲</p>
          <p class="mt-4 text-sm text-ink-soft">Your dice will land here.</p>
        </div>
        <div id="resultContainer" class="hidden">
          {/*
            Every slot is rendered up front — D6 cubes and flat tiles alike — so
            the 3D faces stay in scoped styles instead of being built at runtime
            from JS, where Astro's style scoping would not reach them. Only the
            slots a roll needs are ever made visible.
          */}
          <div id="diceStage" class="dice-stage" aria-hidden="true">
            {Array.from({ length: MAX_DICE }, (_, slot) => (
              <div class="die-slot" data-slot={slot}>
                <div class="die-scene">
                  <div class="die" data-die={slot}>
                    {DIE_FACES.map((face) => (
                      <div
                        class="die-face"
                        data-face={face}
                        style={`transform:${FACE_LAYOUT[face]}`}
                      >
                        {PIP_LAYOUT[face].map((cell) => (
                          <i
                            class="die-pip"
                            style={`grid-row:${pipRow(cell)};grid-column:${pipColumn(cell)}`}
                          ></i>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
                <div class="die-tile"><span data-tile-value>?</span></div>
              </div>
            ))}
          </div>

          <p id="rollSummary" class="mt-5 text-sm font-bold tracking-[0.12em] text-ink-soft"></p>
          <p id="rollAnnounce" class="sr-only" role="status"></p>

          <p class="eyebrow mt-8">Total</p>
          <p id="totalResult" class="mt-2 text-5xl font-bold text-ink sm:text-6xl"></p>
          <div class="mt-8 flex flex-wrap justify-center gap-2">
            <button id="rollAgainBtn" type="button" class="primary-action">Roll again</button>
            <button id="copyBtn" type="button" class="secondary-action">Copy total</button>
          </div>
        </div>
      </section>
    </div>

    <!-- Kept for search engines; the workspace itself is a two-panel layout. -->
    <div class="mx-auto mt-12 max-w-2xl">
      <!-- Common Dice -->
      <section class="legacy-section mb-12">
        <h2 class="text-2xl font-bold mb-6">Common Dice Notation</h2>
        <ul class="space-y-3 text-ink-soft">
          <li class="flex items-start gap-3">
            <span class="font-mono font-bold text-brand-deep">2d6</span>
            <span>Roll 2 six-sided dice</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="font-mono font-bold text-brand-deep">1d20</span>
            <span>Roll 1 twenty-sided die (D&amp;D attack rolls)</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="font-mono font-bold text-brand-deep">3d4</span>
            <span>Roll 3 four-sided dice</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="font-mono font-bold text-brand-deep">4d6</span>
            <span>Roll 4 six-sided dice (D&amp;D ability scores)</span>
          </li>
        </ul>
      </section>

      <!-- FAQ -->
      <section class="legacy-section">
        <h2 class="text-2xl font-bold mb-6">Frequently Asked Questions</h2>
        <div class="space-y-6">
          <div>
            <h3 class="font-bold mb-2">What dice types are available?</h3>
            <p class="text-ink-soft">We support D4, D6, D8, D10, D12, D20, and D100. If you need other dice types, let us know!</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Can I roll many dice at once?</h3>
            <p class="text-ink-soft">Yes — up to six at a time. Every D6 gets its own independent 3D cube and tumble, so six dice land separately rather than moving in lockstep.</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">How are these rolls random?</h3>
            <p class="text-ink-soft">We use cryptographic randomization to ensure each roll is fair and unpredictable. The animation is choreographed to land on the number that was already drawn, so what you see is always the real result.</p>
          </div>
        </div>
      </section>
    </div>
  </ToolLayout>
</Layout>

<script>
  import { getRandomInt, rollMultipleDice } from '../lib/random';
  import { revealResult, burstConfetti } from '../lib/effects';
  import { CUBE_SIDES, MAX_DICE, formatTransform, spinToFace, type Spin } from '../lib/dice';

  const numDice = document.getElementById('numDice') as HTMLInputElement;
  const diceType = document.getElementById('diceType') as HTMLSelectElement;
  const rollBtn = document.getElementById('rollBtn') as HTMLButtonElement;
  const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;
  const resultContainer = document.getElementById('resultContainer') as HTMLElement;
  const emptyState = document.getElementById('emptyState') as HTMLElement;
  const totalResult = document.getElementById('totalResult') as HTMLElement;
  const rollSummary = document.getElementById('rollSummary') as HTMLElement;
  const rollAnnounce = document.getElementById('rollAnnounce') as HTMLElement;
  const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement;
  const rollAgainBtn = document.getElementById('rollAgainBtn') as HTMLButtonElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLElement;

  const slots = Array.from(document.querySelectorAll<HTMLElement>('.die-slot'));

  const prefersReducedMotion =
    window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

  // Absolute angles per slot. Kept across rolls so each tumble continues
  // forward from wherever that die came to rest instead of snapping to zero.
  const spinState: Spin[] = Array.from({ length: MAX_DICE }, () => ({ x: 0, y: 0, z: 0 }));

  let isRolling = false;

  /** Inclusive integer in [min, max] — cosmetic jitter only, never a result. */
  function jitter(min: number, max: number): number {
    return min + Math.floor(Math.random() * (max - min + 1));
  }

  /**
   * Tumble one cube onto `value`.
   *
   * The value is chosen before this runs; the animation only has to arrive at
   * the orientation that shows it. Extra whole revolutions are added on all
   * three axes for the tumble, and because a full revolution is the identity
   * rotation the die still stops exactly on the requested face.
   */
  function rollCube(die: HTMLElement, slot: number, value: number): Promise<void> {
    const from = spinState[slot];
    const to = spinToFace(value, from, { x: jitter(2, 4), y: jitter(2, 4), z: jitter(2, 4) });
    spinState[slot] = to;
    const landing = formatTransform(to);

    if (prefersReducedMotion) {
      die.style.transform = landing;
      return Promise.resolve();
    }

    // A single intermediate keyframe bends the path off a straight
    // interpolation so the axes unwind at different rates. It sits between the
    // endpoints on every axis, so it shapes the motion without moving the
    // landing.
    const mid: Spin = {
      x: from.x + (to.x - from.x) * 0.45,
      y: from.y + (to.y - from.y) * 0.62,
      z: from.z + (to.z - from.z) * 0.5,
    };

    const animation = die.animate(
      [
        { transform: formatTransform(from), offset: 0 },
        { transform: formatTransform(mid), offset: 0.5 },
        { transform: landing, offset: 1 },
      ],
      {
        duration: 1200 + jitter(0, 480),
        easing: 'cubic-bezier(0.18, 0.86, 0.22, 1)',
        fill: 'forwards',
      }
    );

    return animation.finished
      .then(() => {
        // Write the resting transform, then drop the animation. `forwards` fill
        // overrides inline styles while it is active, so setting the transform
        // first would have no visible effect until the cancel lands.
        die.style.transform = landing;
        animation.cancel();
      })
      .catch(() => {
        die.style.transform = landing;
      });
  }

  /** Short shuffle for non-cube dice, which have no faces to tumble. */
  function shuffleTiles(active: HTMLElement[], sides: number): Promise<void> {
    if (prefersReducedMotion) return Promise.resolve();

    const tick = () => {
      for (const slot of active) {
        const value = slot.querySelector('[data-tile-value]');
        if (value) value.textContent = String(getRandomInt(1, sides + 1));
      }
    };

    tick();
    const timer = window.setInterval(tick, 90);
    return new Promise((resolve) => {
      window.setTimeout(() => {
        window.clearInterval(timer);
        resolve();
      }, 620);
    });
  }

  function showSlots(count: number, sides: number) {
    slots.forEach((slot, index) => {
      const active = index < count;
      slot.classList.toggle('is-active', active);
      if (!active) return;
      slot.classList.toggle('is-cube', sides === CUBE_SIDES);
      slot.classList.toggle('is-tile', sides !== CUBE_SIDES);
    });
  }

  function setBusy(busy: boolean) {
    isRolling = busy;
    rollBtn.disabled = busy;
    rollAgainBtn.disabled = busy;
    resetBtn.disabled = busy;
  }

  rollBtn.addEventListener('click', async () => {
    if (isRolling) return;

    const sides = parseInt(diceType.value, 10);
    const requested = parseInt(numDice.value, 10);
    const count = Math.min(Math.max(Number.isNaN(requested) ? 1 : requested, 1), MAX_DICE);
    numDice.value = String(count);

    if (Number.isNaN(sides) || sides < 2) {
      errorMessage.textContent = 'Choose a dice type with at least 2 sides.';
      errorMessage.classList.remove('hidden');
      return;
    }
    errorMessage.classList.add('hidden');

    setBusy(true);
    emptyState.classList.add('hidden');
    totalResult.textContent = '—';
    rollSummary.textContent = '';
    rollAnnounce.textContent = '';
    showSlots(count, sides);
    revealResult(resultContainer);

    // Draw the result first, then animate to it. Nothing about the landing
    // depends on the animation, so an interrupted or reduced-motion roll still
    // shows the number that was actually drawn.
    const rolls = rollMultipleDice(count, sides);
    const active = slots.slice(0, count);

    if (sides === CUBE_SIDES) {
      const dice = active.map((slot) => slot.querySelector<HTMLElement>('.die')!);
      await Promise.all(dice.map((die, index) => rollCube(die, index, rolls[index])));
    } else {
      await shuffleTiles(active, sides);
      active.forEach((slot, index) => {
        const value = slot.querySelector('[data-tile-value]');
        if (value) value.textContent = String(rolls[index]);
      });
    }

    const total = rolls.reduce((sum, roll) => sum + roll, 0);
    totalResult.textContent = String(total);
    rollSummary.textContent = rolls.join(' · ');
    rollAnnounce.textContent =
      count === 1 ? `Rolled ${rolls[0]}.` : `Rolled ${rolls.join(', ')}. Total ${total}.`;

    // Celebrate the moments worth celebrating: every die at max, or a natural
    // 20 on a d20.
    const isMaxRoll = rolls.every((roll) => roll === sides);
    const isCriticalD20 = sides === 20 && rolls.includes(20);
    if (isMaxRoll || isCriticalD20) burstConfetti(totalResult);

    setBusy(false);
  });

  rollAgainBtn.addEventListener('click', () => {
    rollBtn.click();
  });

  copyBtn.addEventListener('click', async () => {
    const text = totalResult.textContent || '';
    try {
      await navigator.clipboard.writeText(text);
      const originalText = copyBtn.textContent;
      copyBtn.textContent = 'Copied';
      setTimeout(() => {
        copyBtn.textContent = originalText;
      }, 2000);
    } catch (err) {
      console.error('Failed to copy:', err);
    }
  });

  resetBtn.addEventListener('click', () => {
    numDice.value = '1';
    diceType.value = String(CUBE_SIDES);
    resultContainer.classList.add('hidden');
    emptyState.classList.remove('hidden');
    errorMessage.classList.add('hidden');
    slots.forEach((slot) => slot.classList.remove('is-active', 'is-cube', 'is-tile'));
    // Return every cube to the orientation matching the reset spin state, or
    // the next roll would tumble from a stale visual position.
    document.querySelectorAll<HTMLElement>('.die').forEach((die) => {
      die.style.transform = '';
    });
    spinState.forEach((spin) => {
      spin.x = 0;
      spin.y = 0;
      spin.z = 0;
    });
    rollSummary.textContent = '';
    rollAnnounce.textContent = '';
    totalResult.textContent = '';
  });
</script>

<style>
  .dice-stage {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem 1.25rem;
    margin: 1.75rem 0 0.5rem;
    min-height: 4rem;
  }

  .die-slot {
    --die-size: clamp(3rem, 15vw, 4rem);
    display: none;
    width: var(--die-size);
    height: var(--die-size);
  }

  .die-slot.is-active {
    display: block;
  }

  .die-slot .die-scene {
    display: none;
  }

  .die-slot.is-cube .die-scene {
    display: block;
  }

  .die-slot .die-tile {
    display: none;
  }

  .die-slot.is-tile .die-tile {
    display: grid;
  }

  .die-scene {
    --die-half: calc(var(--die-size) / 2);
    width: 100%;
    height: 100%;
    perspective: calc(var(--die-size) * 6);
  }

  .die {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .die-face {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    place-items: center;
    gap: 6%;
    padding: 11%;
    border-radius: 16%;
    border: 1px solid var(--color-line);
    background: #fff;
    box-shadow: inset 0 0 12px rgba(23, 35, 63, 0.07);
    /* Faces turned away from the viewer are the ones the front faces already
       occlude; skipping them avoids any depth-sorting artefacts mid-tumble. */
    backface-visibility: hidden;
  }

  .die-pip {
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-ink);
  }

  .die-tile {
    width: 100%;
    height: 100%;
    place-items: center;
    border-radius: 16%;
    border: 1px solid var(--color-line);
    background: var(--color-wash);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .die {
      will-change: auto;
    }
  }
</style>
