---
import Layout from '../../layouts/Layout.astro';
import ListInput from '../../components/ListInput.astro';

const title = 'Spin the Bottle - Random Player Picker | Randomlyo';
const description = 'Arrange players in a circle and spin the bottle to pick someone at random. Perfect for games and group activities.';
---

<Layout title={title} description={description}>
<div class="stb-root" id="stb-root">

  <!-- HEADER -->
  <header class="stb-header">
    <div class="stb-header-inner">
      <a href="/#tools" class="stb-back-link" aria-label="Back to all tools">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Tools
      </a>
      <h1 class="stb-title">Spin the Bottle</h1>
      <div class="stb-controls" role="toolbar" aria-label="Game controls">
        <button id="stb-sound-btn" type="button" class="stb-icon-btn" aria-pressed="false" aria-label="Turn sound on" title="Sound is off">
          <span id="stb-sound-icon" aria-hidden="true">🔇</span>
        </button>
        <button id="stb-theme-btn" type="button" class="stb-icon-btn" aria-pressed="false" aria-label="Switch to dark mode" title="Light mode">
          <span id="stb-theme-icon" aria-hidden="true">🌙</span>
        </button>
      </div>
    </div>
    <div id="stb-toast" class="stb-toast" role="status" aria-live="polite" aria-atomic="true"></div>
  </header>

  <main class="stb-main">
    <!-- SETUP SCREEN -->
    <div class="stb-screen" id="stb-screen-setup">
      <div class="stb-setup-card">
        <p class="stb-eyebrow">Who's playing?</p>
        <h2 class="stb-setup-heading">Add the players</h2>
        <p class="stb-setup-sub">Enter 2–20 player names, then press <strong>Start Game</strong>.</p>

        <div class="stb-input-wrap">
          <label for="stb-players-list" class="sr-only">Player names</label>
          <ListInput
            id="stb-players-list"
            name="stb-players-list"
            defaultValue="Alice, Bob, Charlie, Diana"
            placeholder="Alice, Bob, Charlie…"
            class="stb-list-input"
          />
        </div>

        <div class="stb-options-row">
          <label class="stb-toggle-label" for="stb-remove-toggle">
            <input type="checkbox" id="stb-remove-toggle" class="stb-checkbox" />
            <span class="stb-toggle-track" aria-hidden="true"></span>
            Remove player after selection
          </label>
          <p class="stb-options-hint">Ensures everyone gets picked before repeating.</p>
        </div>

        <div id="stb-setup-error" class="stb-error stb-hidden" role="alert"></div>

        <button id="stb-start-btn" type="button" class="stb-primary-btn">
          Start Game <span aria-hidden="true">&#x2192;</span>
        </button>
      </div>
    </div>

    <!-- GAME SCREEN -->
    <div class="stb-screen stb-hidden" id="stb-screen-game">
      <div class="stb-game-layout">

        <!-- Circle arena -->
        <div class="stb-arena-wrap">
          <div class="stb-arena" id="stb-arena" aria-label="Player circle">

            <!-- Player chips positioned around the circle — injected by JS -->
            <div id="stb-player-ring" aria-live="polite"></div>

            <!-- 3D Bottle in centre -->
            <div class="stb-bottle-scene" id="stb-bottle-scene">
              <div class="stb-bottle-shadow" id="stb-bottle-shadow"></div>
              <!--
                GEOMETRY CONTRACT
                The bottle SVG is drawn so the NECK points UP (toward 12 o'clock).
                BOTTLE_BASE_ANGLE = 0: when CSS rotateZ = 0 deg, neck points to top.
                Player 0 sits at top: playerAngle(0) = -90 + (360/n)*0 = -90 deg CSS.
                finalRotation = FULL_SPINS_DEG + targetPlayerAngle - BOTTLE_BASE_ANGLE
              -->
              <div class="stb-bottle-3d" id="stb-bottle-3d" title="Click to spin!">
                <!-- Bottle SVG: premium wine bottle pointing UP -->
                <svg
                  class="stb-bottle-svg"
                  viewBox="0 0 80 240"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <defs>
                    <!-- Dark green glass body gradient -->
                    <linearGradient id="glassBody" x1="0" y1="0" x2="1" y2="0">
                      <stop offset="0%" stop-color="#0a2a11"/>
                      <stop offset="15%" stop-color="#124a1e"/>
                      <stop offset="30%" stop-color="#2a7a3b"/>
                      <stop offset="60%" stop-color="#1c5728"/>
                      <stop offset="90%" stop-color="#0c3014"/>
                      <stop offset="100%" stop-color="#041207"/>
                    </linearGradient>

                    <!-- Metallic foil/cap gradient -->
                    <linearGradient id="foilGrad" x1="0" y1="0" x2="1" y2="0">
                      <stop offset="0%" stop-color="#690a16"/>
                      <stop offset="25%" stop-color="#b01327"/>
                      <stop offset="70%" stop-color="#800c1b"/>
                      <stop offset="100%" stop-color="#40040c"/>
                    </linearGradient>

                    <!-- Premium Label gradient -->
                    <linearGradient id="labelGrad" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#fffdf0"/>
                      <stop offset="100%" stop-color="#e8e1c3"/>
                    </linearGradient>
                  </defs>

                  <!-- Bottle Silhouette -->
                  <!-- Foil rim detail -->
                  <rect x="30" y="32" width="20" height="4" rx="2" fill="url(#foilGrad)"/>
                  <rect x="31" y="5" width="18" height="6" rx="2" fill="url(#foilGrad)"/>
                  <!-- Neck cap/foil -->
                  <path d="M 32 5 C 32 2, 48 2, 48 5 L 48 40 L 32 40 Z" fill="url(#foilGrad)"/>
                  
                  <!-- Glass Neck -->
                  <rect x="33" y="40" width="14" height="40" fill="url(#glassBody)"/>
                  
                  <!-- Glass Shoulder -->
                  <path d="M 33 80 C 33 110, 15 120, 15 140 L 65 140 C 65 120, 47 110, 47 80 Z" fill="url(#glassBody)"/>
                  
                  <!-- Glass Main Body -->
                  <path d="M 15 140 L 15 220 C 15 235, 65 235, 65 220 L 65 140 Z" fill="url(#glassBody)"/>
                  
                  <!-- Base indent -->
                  <path d="M 25 230 C 40 220, 55 230, 55 230 L 25 230" stroke="#0a2a11" stroke-width="4" fill="none"/>

                  <!-- Left Main Highlight (Curved to match shoulder) -->
                  <path d="M 35 40 L 35 80 C 35 110, 20 120, 20 140 L 20 220" stroke="rgba(255,255,255,0.25)" stroke-width="3" fill="none" stroke-linecap="round"/>
                  <!-- Right edge rim light -->
                  <path d="M 45 40 L 45 80 C 45 110, 60 120, 60 140 L 60 220" stroke="rgba(255,255,255,0.1)" stroke-width="2" fill="none" stroke-linecap="round"/>
                  
                  <!-- Premium Label -->
                  <rect x="22" y="145" width="36" height="50" rx="3" fill="url(#labelGrad)"/>
                  <rect x="25" y="148" width="30" height="44" rx="1" fill="none" stroke="#b09041" stroke-width="1"/>
                  
                  <!-- Label Content (Star + lines) -->
                  <path d="M 40 154 L 42 160 L 48 160 L 43 164 L 45 170 L 40 166 L 35 170 L 37 164 L 32 160 L 38 160 Z" fill="#b09041"/>
                  <rect x="28" y="176" width="24" height="2" rx="1" fill="#4a3c1c"/>
                  <rect x="32" y="181" width="16" height="1.5" rx="0.5" fill="#4a3c1c"/>
                  <rect x="30" y="185" width="20" height="1.5" rx="0.5" fill="#4a3c1c"/>

                  <!-- Pointer dot to emphasize direction at the neck -->
                  <circle cx="40" cy="18" r="3" fill="rgba(255,255,255,0.8)" />
                </svg>
              </div>
            </div>

          </div>

          <!-- Spin button below arena -->
          <button id="stb-spin-btn" type="button" class="stb-spin-btn" disabled>
            Spin the Bottle
          </button>
          <button id="stb-reset-btn" type="button" class="stb-reset-btn">
            &#x2190; Change Players
          </button>
        </div>

        <!-- Result panel -->
        <div class="stb-result-panel" id="stb-result-panel">
          <div id="stb-result-empty" class="stb-result-empty">
            <p class="stb-result-big-icon" aria-hidden="true">&#x1F37E;</p>
            <p class="stb-result-hint">Spin the bottle to pick a player!</p>
          </div>
          <div id="stb-result-content" class="stb-result-content stb-hidden">
            <p class="stb-eyebrow">The bottle chose&hellip;</p>
            <p id="stb-winner-name" class="stb-winner-name"></p>
            <p id="stb-players-left" class="stb-players-left"></p>
            <div class="stb-result-actions">
              <button id="stb-spin-again-btn" type="button" class="stb-primary-btn">Spin Again</button>
              <button id="stb-new-game-btn" type="button" class="stb-secondary-btn">New Game</button>
            </div>
          </div>
          <div id="stb-all-picked" class="stb-all-picked stb-hidden">
            <p class="stb-result-big-icon" aria-hidden="true">&#x1F389;</p>
            <p class="stb-all-picked-msg">Everyone's been picked!</p>
            <button id="stb-restart-btn" type="button" class="stb-primary-btn">Start Over</button>
          </div>
        </div>

      </div>
    </div>
  </main>
</div>
</Layout>

<script>
  import { burstConfetti, createSoundKit } from '../../lib/effects';
  import { getRandomInt } from '../../lib/random';
  import { validateList } from '../../lib/utils';

  /* ─────────────────────────────────────────────
     DOM refs
  ───────────────────────────────────────────── */
  const root        = document.getElementById('stb-root')!;
  const screenSetup = document.getElementById('stb-screen-setup')!;
  const screenGame  = document.getElementById('stb-screen-game')!;
  const playersList = document.getElementById('stb-players-list') as HTMLTextAreaElement;
  const removeTgl   = document.getElementById('stb-remove-toggle') as HTMLInputElement;
  const setupError  = document.getElementById('stb-setup-error')!;
  const startBtn    = document.getElementById('stb-start-btn')!;
  const arena       = document.getElementById('stb-arena')!;
  const playerRing  = document.getElementById('stb-player-ring')!;
  const bottle3d    = document.getElementById('stb-bottle-3d')!;
  const spinBtn     = document.getElementById('stb-spin-btn') as HTMLButtonElement;
  const resetBtn    = document.getElementById('stb-reset-btn')!;
  const resultEmpty = document.getElementById('stb-result-empty')!;
  const resultContent = document.getElementById('stb-result-content')!;
  const allPickedEl = document.getElementById('stb-all-picked')!;
  const winnerName  = document.getElementById('stb-winner-name')!;
  const playersLeft = document.getElementById('stb-players-left')!;
  const spinAgainBtn = document.getElementById('stb-spin-again-btn') as HTMLButtonElement;
  const newGameBtn  = document.getElementById('stb-new-game-btn')!;
  const restartBtn  = document.getElementById('stb-restart-btn')!;
  const toastEl     = document.getElementById('stb-toast')!;
  const soundBtn    = document.getElementById('stb-sound-btn')!;
  const soundIconEl = document.getElementById('stb-sound-icon')!;
  const themeBtn    = document.getElementById('stb-theme-btn')!;
  const themeIconEl = document.getElementById('stb-theme-icon')!;

  /* ─────────────────────────────────────────────
     State
  ───────────────────────────────────────────── */
  let players: string[]    = [];
  let remaining: string[]  = [];
  let removeMode           = false;
  let spinning             = false;

  /**
   * currentBottleAngle tracks the accumulated CSS rotateZ in degrees.
   * It grows monotonically (never wraps) so each successive spin always
   * continues forward from where the bottle last rested.
   */
  let currentBottleAngle = 0;

  const MIN_PLAYERS = 2;
  const MAX_PLAYERS = 20;

  /* ─────────────────────────────────────────────
     ANGLE GEOMETRY  (critical — read before editing)
     ─────────────────────────────────────────────
     Player i sits at angle:
       playerAngleDeg(i, n) = -90 + (360 / n) * i   [CSS degrees]
       i = 0  →  -90° (top / 12 o'clock)
       i = 1, n=4  →  0° (right / 3 o'clock)
       etc.

     Bottle base (unrotated artwork):
       BOTTLE_BASE_ANGLE = 0
       Meaning: at CSS rotateZ(0°) the SVG neck points UP = toward top of page
       = same direction as playerAngleDeg(0, n) = -90° … but wait, shouldn't
         that be -90 not 0?

     Reconciliation: CSS rotateZ is measured from the Y axis (top) clockwise.
       rotateZ(0°)   → neck at top  (effectively -90° in math / unit-circle coords)
       rotateZ(90°)  → neck at right
       rotateZ(180°) → neck at bottom
       rotateZ(270°) → neck at left

     playerAngleDeg uses CSS/screen convention (top = -90°):
       i=0 → -90°  (top)     → the bottle at rotateZ(-90°) points there
       i=1 with n=4 → 0°     → the bottle at rotateZ(0°)   points there

     So BOTTLE_BASE_ANGLE must equal the CSS angle where the neck points to
     the 12-o'clock position: rotateZ(-90°) ≡ bottle neck at top.
     BUT our SVG is drawn so neck points UP = rotateZ(0°) puts neck at top.
     Therefore BOTTLE_BASE_ANGLE = -90 (the CSS angle of the unrotated neck).

     Correction applied here:
       BOTTLE_BASE_ANGLE = -90

     finalRotation = currentBottleAngle + FULL_SPINS_DEG
                   + (targetPlayerAngle - BOTTLE_BASE_ANGLE) normalised forward

     Verification:
       At finalRotation, the bottle neck is at CSS angle:
         neckAngle = (BOTTLE_BASE_ANGLE + finalRotation) mod 360
       The selected player is at:
         playerAngleDeg(selectedIdx, n)   (mod 360, normalised to [0,360))
       These two must match.
  ───────────────────────────────────────────── */

  /**
   * BOTTLE_BASE_ANGLE: the CSS rotateZ angle at which the SVG neck points
   * to the top of the page (12 o'clock).
   *
   * Our SVG is drawn neck-up, so rotateZ(0°) puts the neck at the top.
   * However, our player angle formula gives -90° for "top":
   *   playerAngleDeg(0, n) = -90
   * So the bottle at rotateZ(0°) (neck at top) should correspond to -90° in
   * player-angle space. Therefore BOTTLE_BASE_ANGLE = -90.
   *
   * In plain English: the bottle's "zero" is 90° behind the player-angle "zero".
   */
  const BOTTLE_BASE_ANGLE = -90; // degrees (CSS)

  function playerAngleDeg(index: number, total: number): number {
    // Player 0 at top = -90°, players evenly spaced clockwise.
    return -90 + (360 / total) * index;
  }

  /* ─────────────────────────────────────────────
     Sound (off by default)
  ───────────────────────────────────────────── */
  const SOUND_KEY = 'randomlyo:stb-sound';
  const sound = createSoundKit();
  let soundMuted = true;

  try { soundMuted = localStorage.getItem(SOUND_KEY) !== 'on'; } catch { /* */ }
  applySound(soundMuted);

  function applySound(muted: boolean) {
    soundMuted = muted;
    sound.setMuted(muted);
    soundIconEl.textContent = muted ? '🔇' : '🔊';
    soundBtn.setAttribute('aria-pressed', String(!muted));
    soundBtn.setAttribute('aria-label', muted ? 'Turn sound on' : 'Turn sound off');
    soundBtn.title = muted ? 'Sound is off' : 'Sound is on';
  }

  soundBtn.addEventListener('click', () => {
    const next = !soundMuted;
    applySound(next);
    if (!next) { sound.unlock(); sound.chime(); }
    try { localStorage.setItem(SOUND_KEY, next ? 'on' : 'off'); } catch { /* */ }
  });

  /* ─────────────────────────────────────────────
     Dark/light theme
  ───────────────────────────────────────────── */
  const THEME_KEY = 'randomlyo:stb-theme';
  let darkMode = false;

  try { darkMode = localStorage.getItem(THEME_KEY) === 'dark'; } catch { /* */ }
  applyTheme(darkMode);

  function applyTheme(dark: boolean) {
    darkMode = dark;
    root.classList.toggle('stb-dark', dark);
    themeIconEl.textContent = dark ? '☀️' : '🌙';
    themeBtn.setAttribute('aria-pressed', String(dark));
    themeBtn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    themeBtn.title = dark ? 'Dark mode' : 'Light mode';
  }

  themeBtn.addEventListener('click', () => {
    applyTheme(!darkMode);
    try { localStorage.setItem(THEME_KEY, darkMode ? 'dark' : 'light'); } catch { /* */ }
  });

  /* ─────────────────────────────────────────────
     Toast
  ───────────────────────────────────────────── */
  let toastTimer = 0;
  function showToast(msg: string) {
    toastEl.textContent = msg;
    toastEl.classList.add('stb-toast-show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toastEl.classList.remove('stb-toast-show'), 2800);
  }

  /* ─────────────────────────────────────────────
     Setup → Game
  ───────────────────────────────────────────── */
  startBtn.addEventListener('click', startGame);

  function startGame() {
    const validation = validateList(playersList.value);
    if (!validation.valid) {
      setupError.textContent = validation.error || 'Add at least 2 players.';
      setupError.classList.remove('stb-hidden');
      return;
    }
    const names = validation.items.slice(0, MAX_PLAYERS);
    if (names.length < MIN_PLAYERS) {
      setupError.textContent = `Add at least ${MIN_PLAYERS} players to play.`;
      setupError.classList.remove('stb-hidden');
      return;
    }
    setupError.classList.add('stb-hidden');
    players   = names;
    remaining = [...players];
    removeMode = removeTgl.checked;
    currentBottleAngle = 0;
    bottle3d.style.transform = 'rotateZ(0deg)';

    screenSetup.classList.add('stb-hidden');
    screenGame.classList.remove('stb-hidden');

    buildPlayerRing();
    showResultEmpty();
    spinBtn.disabled = false;
  }

  /* ─────────────────────────────────────────────
     Player ring
  ───────────────────────────────────────────── */
  function buildPlayerRing() {
    playerRing.innerHTML = '';

    const active = removeMode ? remaining : players;
    const total  = active.length;
    if (total === 0) return;

    const arenaSize  = arena.clientWidth || 480;
    // Shrink ring radius for more players so chips don't overlap
    const baseRatio  = total <= 6 ? 0.41 : total <= 12 ? 0.40 : 0.38;
    const ringRadius = Math.min(arenaSize * baseRatio, 210);

    active.forEach((name, i) => {
      const angleDeg = playerAngleDeg(i, total);
      const angleRad = angleDeg * (Math.PI / 180);

      const chip = document.createElement('div');
      chip.className = 'stb-player-chip';
      chip.dataset.index = String(i);
      chip.textContent = name.length > 12 ? name.slice(0, 11) + '\u2026' : name;
      chip.title = name;
      chip.setAttribute('aria-label', `Player ${i + 1}: ${name}`);

      // Convert px radius to %-of-arenaSize, centred at 50%.
      const pct = (ringRadius / arenaSize) * 100;
      const cx  = 50 + pct * Math.cos(angleRad);
      const cy  = 50 + pct * Math.sin(angleRad);
      chip.style.left = `${cx}%`;
      chip.style.top  = `${cy}%`;

      playerRing.appendChild(chip);
    });
  }

  const resizeObs = new ResizeObserver(() => {
    if (!screenGame.classList.contains('stb-hidden')) buildPlayerRing();
  });
  resizeObs.observe(arena);

  /* ─────────────────────────────────────────────
     Result panel helpers
  ───────────────────────────────────────────── */
  function showResultEmpty() {
    resultEmpty.classList.remove('stb-hidden');
    resultContent.classList.add('stb-hidden');
    allPickedEl.classList.add('stb-hidden');
  }

  function showResultWinner(name: string) {
    resultEmpty.classList.add('stb-hidden');
    allPickedEl.classList.add('stb-hidden');
    resultContent.classList.remove('stb-hidden');
    winnerName.textContent = name;

    if (removeMode) {
      const left = remaining.length;
      playersLeft.textContent =
        left === 0
          ? 'Everyone has been picked!'
          : `${left} player${left === 1 ? '' : 's'} left`;
    } else {
      playersLeft.textContent = '';
    }

    resultContent.classList.remove('result-reveal');
    void resultContent.offsetWidth;
    resultContent.classList.add('result-reveal');
  }

  function showAllPicked() {
    resultEmpty.classList.add('stb-hidden');
    resultContent.classList.add('stb-hidden');
    allPickedEl.classList.remove('stb-hidden');
  }

  /* ─────────────────────────────────────────────
     Chip highlights
  ───────────────────────────────────────────── */
  function highlightChip(index: number) {
    playerRing.querySelectorAll('.stb-player-chip').forEach((el, i) => {
      el.classList.toggle('stb-chip-winner', i === index);
      el.classList.toggle('stb-chip-dimmed', i !== index);
    });
  }

  function clearHighlights() {
    playerRing.querySelectorAll('.stb-player-chip').forEach(el => {
      el.classList.remove('stb-chip-winner', 'stb-chip-dimmed');
    });
  }

  /* ─────────────────────────────────────────────
     SPIN  — geometry-critical section
     ─────────────────────────────────────────────
     Formula (see ANGLE GEOMETRY block above):

       targetPlayerAngle = playerAngleDeg(winnerIdx, total)
       finalRotation     = currentBottleAngle
                           + FULL_SPINS_DEG
                           + (targetPlayerAngle - BOTTLE_BASE_ANGLE - currentBottleAngle) mod 360

     The mod-360 term gives the smallest non-negative extra rotation
     needed to land the neck exactly on targetPlayerAngle, beyond the
     base full-spin landing. This ensures we always spin forward.

     Verification identity (logged after each spin):
       neckAngle = (BOTTLE_BASE_ANGLE + finalRotation) mod 360  (normalised)
       playerTarget = targetPlayerAngle mod 360                  (normalised)
     These must be equal within floating-point tolerance.
     ───────────────────────────────────────────── */
  spinBtn.addEventListener('click', doSpin);
  spinAgainBtn.addEventListener('click', doSpin);
  bottle3d.addEventListener('click', doSpin);

  function doSpin() {
    if (spinning) return;

    const FULL_SPIN_COUNT = getRandomInt(5, 9);
    const FULL_SPINS_DEG  = FULL_SPIN_COUNT * 360;

    const active = removeMode ? remaining : players;
    if (active.length < MIN_PLAYERS) {
      showToast('Need at least 2 players to spin.');
      return;
    }

    if (!soundMuted) sound.unlock();

    spinning = true;
    spinBtn.disabled = true;
    spinAgainBtn.disabled = true;
    clearHighlights();

    // 1. Pick winner
    const winnerIdx  = getRandomInt(0, active.length);
    const winnerNm   = active[winnerIdx];
    const total      = active.length;

    // 2. Target angle in CSS degrees
    const targetPlayerAngle = playerAngleDeg(winnerIdx, total);

    // 3. Compute final rotation (see formula above)
    //    We start from currentBottleAngle + FULL_SPINS_DEG (our "base landing").
    //    Then find the minimal forward delta to land at targetPlayerAngle.
    const baseLanding = currentBottleAngle + FULL_SPINS_DEG;
    // What CSS angle does BOTTLE_BASE_ANGLE + baseLanding correspond to?
    // We need to go from there to targetPlayerAngle (forward = positive delta).
    const neckAtBase   = BOTTLE_BASE_ANGLE + baseLanding;
    const delta = ((targetPlayerAngle - neckAtBase) % 360 + 360) % 360;
    const finalRotation = baseLanding + delta;

    // 4. Animate
    const startAngle = currentBottleAngle;
    const totalDelta = finalRotation - startAngle;

    const DURATION = getRandomInt(2500, 4001); // 2.5s to 4.0s
    const WOBBLE_AMP = 5;
    const OVERSHOOT = 15; // end-of-spin settle overshoot in degrees
    const SETTLE_AT = 0.90; // When to start the settle-back
    let   startTime: number | null = null;

    const easeOutQuart = (t: number) => 1 - Math.pow(1 - t, 4);
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
    const bottleShadow = document.getElementById('stb-bottle-shadow')!;

    let lastTickAngle = startAngle;

    function frame(ts: number) {
      if (startTime === null) startTime = ts;
      const elapsed  = ts - startTime;
      const progress = Math.min(elapsed / DURATION, 1);

      let curAngle = 0;
      let wobbleFade = 0;

      if (progress <= SETTLE_AT) {
        const eased = easeOutQuart(progress / SETTLE_AT);
        curAngle = startAngle + (totalDelta + OVERSHOOT) * eased;
        wobbleFade = 1 - easeOutCubic(progress / SETTLE_AT);
      } else {
        const t = (progress - SETTLE_AT) / (1 - SETTLE_AT);
        curAngle = finalRotation + OVERSHOOT * (1 - easeOutCubic(t));
        wobbleFade = 0;
      }

      // Y-axis wobble: oscillates and fades out smoothly toward the settle phase
      const wobble = Math.sin(progress * Math.PI * 14) * WOBBLE_AMP * wobbleFade;
      bottle3d.style.transform = `rotateZ(${curAngle}deg) rotateY(${wobble}deg)`;

      // Grounded shadow effect that shifts dynamically with wobble
      const shadowX = Math.sin(progress * Math.PI * 14) * 12 * wobbleFade;
      const shadowY = 4 + Math.abs(wobble) * 2;
      bottleShadow.style.transform = `translate(calc(-50% + ${shadowX}px), calc(-50% + ${shadowY}px))`;
      bottleShadow.style.opacity = `${0.6 - (Math.abs(wobble) / WOBBLE_AMP) * 0.2}`;

      // Sound tick every ~30 degrees of spin
      if (!soundMuted) {
        const tickStep = 30;
        const prevTick = Math.floor(lastTickAngle / tickStep);
        const curTick  = Math.floor(curAngle   / tickStep);
        if (curTick > prevTick) sound.tick();
      }
      lastTickAngle = curAngle;

      if (progress < 1) {
        requestAnimationFrame(frame);
        return;
      }

      // ── ANIMATION COMPLETE ──

      // Lock to exact final rotation (no wobble at rest)
      bottle3d.style.transform = `rotateZ(${finalRotation}deg)`;
      bottleShadow.style.transform = `translate(-50%, calc(-50% + 4px))`;
      bottleShadow.style.opacity = `0.6`;

      // Normalise currentBottleAngle to [0, 360) for consistent next-spin math
      currentBottleAngle = ((finalRotation % 360) + 360) % 360;

      // ── VERIFICATION LOG — gated behind DEBUG flag (proven correct, off in prod) ──
      const DEBUG = false;
      if (DEBUG) {
        const norm = (a: number) => ((a % 360) + 360) % 360;
        const computedAngleUnderBottleTip = norm(BOTTLE_BASE_ANGLE + finalRotation);
        const expectedPlayerAngle         = norm(targetPlayerAngle);
        const diff  = Math.abs(computedAngleUnderBottleTip - expectedPlayerAngle);
        const match = diff < 0.001 || Math.abs(diff - 360) < 0.001;
        console.log('[SpinTheBottle] Verification:', {
          selectedPlayerIndex:         winnerIdx,
          selectedPlayerName:          winnerNm,
          finalRotationDegrees:        Math.round(finalRotation * 1000) / 1000,
          computedAngleUnderBottleTip: Math.round(computedAngleUnderBottleTip * 1000) / 1000,
          expectedPlayerAngle:         Math.round(expectedPlayerAngle * 1000) / 1000,
          match,
        });
      }

      // ── Post-spin ──
      highlightChip(winnerIdx);
      showResultWinner(winnerNm);
      sound.chime();
      burstConfetti(winnerName, { count: 40, spread: 120, duration: 2000 });

      if (removeMode) {
        remaining.splice(winnerIdx, 1);
        if (remaining.length === 0) {
          setTimeout(() => { showAllPicked(); spinBtn.disabled = true; }, 1200);
        } else if (remaining.length < MIN_PLAYERS) {
          setTimeout(() => {
            buildPlayerRing();
            showToast('Only 1 player left — start a new game to continue.');
            spinBtn.disabled = true;
          }, 800);
        } else {
          setTimeout(() => buildPlayerRing(), 800);
          spinBtn.disabled = false;
        }
      } else {
        spinBtn.disabled = false;
      }

      spinning = false;
      spinAgainBtn.disabled = false;
    }

    requestAnimationFrame(frame);
  }

  /* ─────────────────────────────────────────────
     Navigation
  ───────────────────────────────────────────── */
  function goToSetup() {
    screenGame.classList.add('stb-hidden');
    screenSetup.classList.remove('stb-hidden');
    spinning = false;
    spinBtn.disabled = false;
  }

  resetBtn.addEventListener('click', goToSetup);
  newGameBtn.addEventListener('click', goToSetup);

  restartBtn.addEventListener('click', () => {
    remaining = [...players];
    currentBottleAngle = 0;
    bottle3d.style.transform = 'rotateZ(0deg)';
    buildPlayerRing();
    clearHighlights();
    showResultEmpty();
    spinBtn.disabled = false;
    allPickedEl.classList.add('stb-hidden');
  });
</script>

