---
import Layout from '../layouts/Layout.astro';
import ToolLayout from '../components/ToolLayout.astro';
import ListInput from '../components/ListInput.astro';

const defaultFoods = 'Pizza, Pasta, Sushi, Burgers, Tacos, Salad, Thai Food, Chinese Food';
---

<Layout title="What Should We Eat? | Randomlyo" description="Let Randomlyo choose dinner when nobody can decide.">
  <ToolLayout title="What Should We Eat?" description="Let Randomlyo choose dinner when nobody can decide." toolId="whatShouldWeEat">
    <div class="grid items-start gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="surface p-5 sm:p-7">
        <p class="eyebrow">Dinner options</p>
        <h2 id="food-options" class="mt-2 text-xl">What is on the menu?</h2>
        <ListInput id="foodList" defaultValue={defaultFoods} placeholder="Pizza, Tacos, Sushi" class="mt-5" />
        <p class="mt-3 text-xs text-ink-soft">Separate options with commas or new lines.</p>
        <button id="chooseFood" type="button" class="primary-action mt-6 w-full">Choose dinner</button>
        <p id="foodError" class="mt-4 hidden border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert"></p>
      </div>
      <div class="surface flex min-h-[25rem] flex-col justify-center bg-white p-5 text-center sm:p-8" aria-live="polite">
        <p class="eyebrow">Dinner decision</p>
        <p id="foodResult" class="mt-6 min-h-16 text-5xl sm:text-6xl">?</p>
        <p id="foodHint" class="mt-4 text-sm text-ink-soft">One less thing to decide tonight.</p>
      </div>
    </div>
    <p class="mt-5 text-center text-xs text-ink-soft">Randomlyo keeps the choice on your device.</p>
  </ToolLayout>
</Layout>

<script>
  import { pickRandom } from '../lib/random';
  import { validateList } from '../lib/utils';
  import { revealResult } from '../lib/effects';

  const foodList = document.getElementById('foodList') as HTMLTextAreaElement;
  const result = document.getElementById('foodResult') as HTMLElement;
  const hint = document.getElementById('foodHint') as HTMLElement;
  const error = document.getElementById('foodError') as HTMLElement;
  const button = document.getElementById('chooseFood') as HTMLButtonElement;
  let revealing = false;

  function shuffleReveal(items: string[], finalPick: string): Promise<void> {
    return new Promise((resolve) => {
      if (items.length <= 1) {
        result.textContent = finalPick;
        revealResult(result);
        resolve();
        return;
      }
      const duration = 1100;
      const startedAt = performance.now();
      result.classList.add('is-shuffling');
      const timer = window.setInterval(() => {
        if (performance.now() - startedAt >= duration) {
          window.clearInterval(timer);
          result.textContent = finalPick;
          result.classList.remove('is-shuffling');
          revealResult(result);
          resolve();
          return;
        }
        result.textContent = pickRandom(items);
      }, 80);
    });
  }

  button?.addEventListener('click', async () => {
    if (revealing) return;
    const validation = validateList(foodList.value);
    if (!validation.valid) {
      error.textContent = validation.error || 'Add at least one option';
      error.classList.remove('hidden');
      return;
    }
    error.classList.add('hidden');
    revealing = true;
    button.disabled = true;
    hint.textContent = 'Picking dinner...';
    const winner = pickRandom(validation.items);
    await shuffleReveal(validation.items, winner);
    hint.textContent = 'That is dinner sorted.';
    revealing = false;
    button.disabled = false;
  });
</script>

<style>
  #foodResult.is-shuffling {
    animation: foodShuffle 0.36s ease-in-out infinite;
  }

  @keyframes foodShuffle {
    0%, 100% {
      transform: translateY(0) scale(1);
      opacity: 0.55;
    }
    50% {
      transform: translateY(-6px) scale(1.05);
      opacity: 1;
    }
  }
</style>
