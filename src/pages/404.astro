---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="py-24 sm:py-32">
    <div class="container-safe text-center">
      <h1 class="mb-4 text-6xl font-bold text-ink sm:text-7xl">404</h1>
      <h2 class="mb-6 text-3xl font-bold">Page Not Found</h2>
      <p class="mx-auto mb-8 max-w-md text-lg text-ink-soft">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="primary-action">
        Go Home
      </a>
    </div>
  </div>
</Layout>
